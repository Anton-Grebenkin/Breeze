<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Tests use Russian UI strings regardless of the Windows language (ADR 0011). -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared\TestUiCulture.cs" Link="Shared\TestUiCulture.cs" />
  </ItemGroup>

</Project>
