<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end scenarios on the real app window via FlaUI. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Only for the clipboard of paste scenarios (TestClipboard). -->
    <UseWPF>true</UseWPF>
    <IsTestProject>true</IsTestProject>
    <AppExePath>$(MSBuildThisFileDirectory)..\..\src\Apps\CodeEditor.App\bin\$(Configuration)\net10.0-windows\Breeze.exe</AppExePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FlaUI.UIA3" />
    <!-- A headless page of the real engine for the browser tool's page scripts (HeadlessBrowserPage). -->
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF leaves System.IO out of the implicit usings (its Path clashes with WPF shapes). -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI tests drive a single window, so parallel runs are disabled. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds the app before the tests; the tests don't reference the App assembly itself. -->
    <ProjectReference Include="..\..\src\Apps\CodeEditor.App\CodeEditor.App.csproj"
                      ReferenceOutputAssembly="false" />
    <!-- The secret store, to write a test key for the fake model. -->
    <ProjectReference Include="..\..\src\Platform\CodeEditor.Core\CodeEditor.Core.csproj" />
    <!-- The browser tool's page scripts and reading, run on the real engine. -->
    <ProjectReference Include="..\..\src\Modules\CodeEditor.Modules.Browser\CodeEditor.Modules.Browser.csproj" />
    <!-- The product's browser engine, run in a window off the screen (OffScreenBrowser). -->
    <ProjectReference Include="..\..\src\Modules\CodeEditor.Modules.Browser.Wpf\CodeEditor.Modules.Browser.Wpf.csproj" />
    <!-- Views of the product shown in a window off the screen (OffScreenView), with test doubles for their services. -->
    <ProjectReference Include="..\..\src\Modules\CodeEditor.Modules.Agent.Wpf\CodeEditor.Modules.Agent.Wpf.csproj" />
    <ProjectReference Include="..\CodeEditor.Testing\CodeEditor.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppExePath</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(AppExePath)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
