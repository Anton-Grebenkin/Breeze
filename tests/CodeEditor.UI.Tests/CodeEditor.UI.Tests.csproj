<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end scenarios on the real app window via FlaUI. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <AppExePath>$(MSBuildThisFileDirectory)..\..\src\Apps\CodeEditor.App\bin\$(Configuration)\net10.0-windows\Breeze.exe</AppExePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FlaUI.UIA3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI tests drive a single window, so parallel runs are disabled. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds the app before the tests; the tests don't reference the App assembly itself. -->
    <ProjectReference Include="..\..\src\Apps\CodeEditor.App\CodeEditor.App.csproj"
                      ReferenceOutputAssembly="false" />
    <!-- The secret store, to write a test key for the fake model. -->
    <ProjectReference Include="..\..\src\Platform\CodeEditor.Core\CodeEditor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppExePath</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(AppExePath)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
