<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:parsing="clr-namespace:CodeEditor.Modules.Git.Services.Parsing;assembly=CodeEditor.Modules.Git">

  <!-- Shared git view styles: icon buttons, list rows, diff rows. Colors come from theme tokens only. -->

  <Style x:Key="Button.Toolbar" TargetType="ButtonBase" BasedOn="{StaticResource Button.Subtle}">
    <Setter Property="Padding" Value="4" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Icon}" />
  </Style>

  <!-- Row action: visible on hover and on the selected row; keyboard users go through the context menu. -->
  <Style x:Key="Button.RowAction" TargetType="Button" BasedOn="{StaticResource Button.Toolbar}">
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <!-- File status letter ("M", "A", "D", "U", "!"), colored by status as in VS Code. -->
  <Style x:Key="TextBlock.StatusLetter" TargetType="TextBlock">
    <Setter Property="Width" Value="16" />
    <Setter Property="Margin" Value="4,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static parsing:GitFileStatus.Modified}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Git.Modified}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static parsing:GitFileStatus.TypeChanged}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Git.Modified}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static parsing:GitFileStatus.Added}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Git.Added}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static parsing:GitFileStatus.Deleted}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Git.Deleted}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static parsing:GitFileStatus.Untracked}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Git.Untracked}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static parsing:GitFileStatus.Renamed}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Git.Untracked}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static parsing:GitFileStatus.Copied}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Git.Untracked}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static parsing:GitFileStatus.Conflict}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Git.Conflict}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- List row (history, commit files): hover and selection background like tree rows. -->
  <Style x:Key="ListBoxItem.Row" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.List.HoverBackground}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="Selector.IsSelectionActive" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.List.HoverBackground}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="Selector.IsSelectionActive" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.List.SelectionBackground}" />
              <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Border}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.List.SelectionForeground}" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ListBox.Rows" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItem.Row}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Tree}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
  </Style>

  <!-- Diff row: added/removed backgrounds, file and hunk headers, selection for copying. -->
  <Style x:Key="ListBoxItem.DiffRow" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Editor.Foreground}" />
    <Setter Property="AutomationProperties.AutomationId" Value="GitDiff.Row" />
    <Setter Property="AutomationProperties.Name" Value="{Binding Text, Mode=OneTime}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="Kind" Background="Transparent" />
            <Border x:Name="Selection" Background="Transparent" />
            <ContentPresenter />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static parsing:GitDiffRowKind.Added}">
              <Setter TargetName="Kind" Property="Background" Value="{DynamicResource Brush.Diff.InsertedBackground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static parsing:GitDiffRowKind.Removed}">
              <Setter TargetName="Kind" Property="Background" Value="{DynamicResource Brush.Diff.RemovedBackground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static parsing:GitDiffRowKind.Hunk}">
              <Setter TargetName="Kind" Property="Background" Value="{DynamicResource Brush.Editor.LineHighlight}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static parsing:GitDiffRowKind.File}">
              <Setter TargetName="Kind" Property="Background" Value="{DynamicResource Brush.Widget.Background}" />
              <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind, Mode=OneTime}" Value="{x:Static parsing:GitDiffRowKind.Note}">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
              <Setter Property="FontStyle" Value="Italic" />
            </DataTrigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Selection" Property="Background" Value="{DynamicResource Brush.Editor.Selection}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Old number, new number, marker, text. One-time bindings: rows are immutable. -->
  <DataTemplate x:Key="DiffRowTemplate" DataType="{x:Type parsing:GitDiffRow}">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="52" />
        <ColumnDefinition Width="52" />
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Padding="0,0,8,0" TextAlignment="Right" Foreground="{DynamicResource Brush.Editor.LineNumber}" Text="{Binding OldNumber, Mode=OneTime}" />
      <TextBlock Grid.Column="1" Padding="0,0,8,0" TextAlignment="Right" Foreground="{DynamicResource Brush.Editor.LineNumber}" Text="{Binding NewNumber, Mode=OneTime}" />
      <TextBlock Grid.Column="2" TextAlignment="Center" Text="{Binding Marker, Mode=OneTime}" />
      <TextBlock Grid.Column="3" Padding="0,0,16,0" Text="{Binding Text, Mode=OneTime}" />
    </Grid>
  </DataTemplate>

  <Style x:Key="ListBox.Diff" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Editor.Background}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Code}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Code}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItem.DiffRow}" />
    <Setter Property="ItemTemplate" Value="{StaticResource DiffRowTemplate}" />
    <Setter Property="SelectionMode" Value="Extended" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
  </Style>

  <!-- Message in place of content ("Loading…", "No changes", a git error); the text is selectable. -->
  <Style x:Key="TextBox.Message" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost"
                        Background="{TemplateBinding Background}"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
