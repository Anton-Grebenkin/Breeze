<UserControl x:Class="CodeEditor.Modules.Git.Wpf.Views.GitDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tabs="clr-namespace:CodeEditor.Modules.Git.ViewModels.Tabs;assembly=CodeEditor.Modules.Git"
             xmlns:res="clr-namespace:CodeEditor.Modules.Git.Resources;assembly=CodeEditor.Modules.Git"
             xmlns:ui="clr-namespace:CodeEditor.UI.Themes;assembly=CodeEditor.UI"
             xmlns:controls="clr-namespace:CodeEditor.UI.Controls;assembly=CodeEditor.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=tabs:GitDiffViewModel}"
             Background="{DynamicResource Brush.Editor.Background}"
             AutomationProperties.AutomationId="GitDiff">
  <UserControl.Resources>
    <ResourceDictionary Source="GitStyles.xaml" />
  </UserControl.Resources>

  <DockPanel>
    <!-- Path, "+12 −3" summary, open file, refresh. -->
    <DockPanel DockPanel.Dock="Top" Height="30" Margin="12,0,8,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" FontSize="{DynamicResource FontSize.Small}" Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="{Binding Summary}" AutomationProperties.AutomationId="GitDiff.Summary" />
        <Button Style="{StaticResource Button.Toolbar}" ToolTip="{x:Static res:Strings.OpenFileToolTip}" Command="{Binding OpenFileCommand}"
                Content="{Binding Source=go-to-file, Mode=OneTime, Converter={x:Static controls:IconGlyphConverter.Instance}}"
                AutomationProperties.AutomationId="GitDiff.OpenFile" AutomationProperties.Name="{x:Static res:Strings.OpenFileToolTip}" />
        <Button Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.Refresh}" ToolTip="{x:Static res:Strings.RefreshToolTip}"
                Command="{Binding RefreshCommand}"
                AutomationProperties.AutomationId="GitDiff.Refresh" AutomationProperties.Name="{x:Static res:Strings.RefreshToolTip}" />
      </StackPanel>
      <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Secondary}"
                 Text="{Binding Path}" ToolTip="{Binding Path}" AutomationProperties.AutomationId="GitDiff.Path" />
    </DockPanel>

    <TextBox DockPanel.Dock="Top" Margin="12,4,12,8" MaxHeight="200" Style="{StaticResource TextBox.Message}" Text="{Binding Message, Mode=OneWay}"
             Visibility="{Binding Message, Converter={x:Static controls:NullToCollapsedConverter.Instance}}"
             AutomationProperties.AutomationId="GitDiff.Message" />

    <!-- Diff rows are virtualized, so huge diffs stay fast; selected rows copy with Ctrl+C. -->
    <ListBox x:Name="Lines"
             Style="{StaticResource ListBox.Diff}"
             ItemsSource="{Binding Rows}"
             AutomationProperties.AutomationId="GitDiff.Lines"
             AutomationProperties.Name="{x:Static res:Strings.DiffLines}">
      <ListBox.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopy" CanExecute="OnCanCopy" />
      </ListBox.CommandBindings>
      <!-- "Copy" is the same routed command as Ctrl+C, handled by the list. -->
      <ListBox.ContextMenu>
        <ContextMenu AutomationProperties.AutomationId="GitDiff.ContextMenu">
          <MenuItem Style="{StaticResource MenuItem.Base}" Header="{x:Static res:Strings.CopyLines}" InputGestureText="Ctrl+C"
                    Command="ApplicationCommands.Copy" AutomationProperties.AutomationId="GitDiff.Copy" />
        </ContextMenu>
      </ListBox.ContextMenu>
    </ListBox>
  </DockPanel>
</UserControl>
