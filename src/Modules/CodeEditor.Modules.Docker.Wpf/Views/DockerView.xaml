<UserControl x:Class="CodeEditor.Modules.Docker.Wpf.Views.DockerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CodeEditor.Modules.Docker.ViewModels;assembly=CodeEditor.Modules.Docker"
             xmlns:ui="clr-namespace:CodeEditor.UI.Themes;assembly=CodeEditor.UI"
             xmlns:controls="clr-namespace:CodeEditor.UI.Controls;assembly=CodeEditor.UI"
             xmlns:res="clr-namespace:CodeEditor.Modules.Docker.Resources;assembly=CodeEditor.Modules.Docker"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DockerViewModel}"
             IsVisibleChanged="OnIsVisibleChanged"
             AutomationProperties.AutomationId="Docker">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DockerTreeTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <!-- Containers, images and compose in one tree, like the VS Code Docker extension and Services in Rider. -->
  <Grid>
    <TextBlock Margin="16" TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.Text.Secondary}"
               Text="{Binding Message}"
               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
               AutomationProperties.AutomationId="Docker.Loading" />

    <!-- No docker or engine stopped: what to do, and Refresh. -->
    <StackPanel Margin="16" Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibility}}">
      <TextBlock TextWrapping="Wrap"
                 Foreground="{DynamicResource Brush.Text.Secondary}"
                 Text="{Binding Message}"
                 AutomationProperties.AutomationId="Docker.Message" />
      <Button x:Name="Retry"
              Margin="0,12,0,0"
              HorizontalAlignment="Stretch"
              Style="{StaticResource Button.CommandCenter}"
              Command="{Binding RefreshPanelCommand}"
              Content="{x:Static res:Strings.PanelRefresh}"
              AutomationProperties.AutomationId="Docker.Retry" />
    </StackPanel>

    <DockPanel Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVisibility}}">
      <DockPanel DockPanel.Dock="Top" Height="24" Margin="8,0,4,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.Refresh}" ToolTip="{x:Static res:Strings.PanelRefresh}"
                  Command="{Binding RefreshPanelCommand}"
                  AutomationProperties.AutomationId="Docker.Refresh" AutomationProperties.Name="{x:Static res:Strings.PanelRefresh}" />
          <Button Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.CollapseAll}" ToolTip="{x:Static res:Strings.PanelCollapseAll}"
                  Command="{Binding CollapseAllCommand}"
                  AutomationProperties.AutomationId="Docker.CollapseAll" AutomationProperties.Name="{x:Static res:Strings.PanelCollapseAll}" />
        </StackPanel>
        <Border />
      </DockPanel>

      <!-- Last action error: visible until dismissed or the next action succeeds. -->
      <DockPanel DockPanel.Dock="Top" Margin="12,0,4,4"
                 Visibility="{Binding Activity.Error, Converter={x:Static controls:NullToCollapsedConverter.Instance}}">
        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Button.Toolbar}"
                Content="{x:Static ui:IconGlyphs.Close}" ToolTip="{x:Static res:Strings.DismissError}"
                Command="{Binding Activity.DismissCommand}"
                AutomationProperties.AutomationId="Docker.DismissError" AutomationProperties.Name="{x:Static res:Strings.DismissError}" />
        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Error.Foreground}"
                   Text="{Binding Activity.Error}"
                   AutomationProperties.AutomationId="Docker.Error" />
      </DockPanel>

      <TreeView x:Name="Tree"
                Style="{StaticResource TreeView.Files}"
                ItemsSource="{Binding Tree.Sections}"
                SelectedItemChanged="OnSelectedItemChanged"
                IsKeyboardFocusWithinChanged="OnTreeFocusChanged"
                AutomationProperties.AutomationId="Docker.Tree"
                AutomationProperties.Name="{x:Static res:Strings.ModuleName}">
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeViewItem.Row}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemRightButtonDown" />
            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
          </Style>
        </TreeView.ItemContainerStyle>
        <TreeView.ContextMenu>
          <ContextMenu ItemsSource="{Binding ContextMenu.Items}"
                       ItemContainerStyle="{StaticResource MenuItem.Bound}"
                       Opened="OnContextMenuOpened"
                       AutomationProperties.AutomationId="Docker.ContextMenu" />
        </TreeView.ContextMenu>
      </TreeView>
    </DockPanel>
  </Grid>
</UserControl>
