<UserControl x:Class="CodeEditor.Modules.Documents.Wpf.Views.PdfViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CodeEditor.Modules.Documents.ViewModels;assembly=CodeEditor.Modules.Documents"
             xmlns:views="clr-namespace:CodeEditor.Modules.Documents.Wpf.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PdfViewerViewModel}"
             Background="{DynamicResource Brush.Editor.Background}"
             AutomationProperties.AutomationId="PdfViewer">
  <!-- The browser's built-in PDF viewer provides pages, search, zoom, selection and printing. -->
  <DockPanel>
    <views:ViewerToolbar DockPanel.Dock="Top" />
    <TextBlock x:Name="Unavailable" DockPanel.Dock="Top" Margin="8" TextWrapping="Wrap" Visibility="Collapsed"
               Foreground="{DynamicResource Brush.Error.Foreground}"
               AutomationProperties.AutomationId="PdfViewer.Unavailable" />
    <ContentControl x:Name="Host" Focusable="False" />
  </DockPanel>
</UserControl>
