<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Terminal panel view (ADR 0045): xterm.js on a WebView2 page. WebView2 assemblies load when the panel is first
    shown, so they do not affect startup.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeEditor.Modules.Terminal\CodeEditor.Modules.Terminal.csproj" />
    <ProjectReference Include="..\..\Platform\CodeEditor.UI\CodeEditor.UI.csproj" />
    <ProjectReference Include="..\..\Platform\CodeEditor.Shell.Wpf\CodeEditor.Shell.Wpf.csproj" />
  </ItemGroup>

  <!--
    The page goes to the Terminal folder next to the app; WebView2 opens it via a virtual host. xterm.js 6.0.0 and its
    fit addon 0.11.0 are unmodified copies from npm (MIT license, THIRD-PARTY-NOTICES.md).
  -->
  <ItemGroup>
    <Content Include="Assets\**" Link="Terminal\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
