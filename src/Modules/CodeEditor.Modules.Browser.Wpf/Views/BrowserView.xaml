<UserControl x:Class="CodeEditor.Modules.Browser.Wpf.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CodeEditor.Modules.Browser.ViewModels;assembly=CodeEditor.Modules.Browser"
             xmlns:ui="clr-namespace:CodeEditor.UI.Themes;assembly=CodeEditor.UI"
             xmlns:controls="clr-namespace:CodeEditor.UI.Controls;assembly=CodeEditor.UI"
             xmlns:res="clr-namespace:CodeEditor.Modules.Browser.Resources;assembly=CodeEditor.Modules.Browser"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BrowserViewModel}"
             AutomationProperties.AutomationId="Browser"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
  <UserControl.Resources>
    <Style x:Key="Button.Toolbar" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
      <Setter Property="Padding" Value="4" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Icon}" />
    </Style>
  </UserControl.Resources>

  <!-- Address bar and page; both the user and the agent drive the page. -->
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="4">
      <Button DockPanel.Dock="Left" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.ArrowLeft}"
              ToolTip="{x:Static res:Strings.Back}" Command="{Binding BackCommand}"
              AutomationProperties.AutomationId="Browser.Back" AutomationProperties.Name="{x:Static res:Strings.Back}" />
      <Button DockPanel.Dock="Left" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.ArrowRight}"
              ToolTip="{x:Static res:Strings.Forward}" Command="{Binding ForwardCommand}"
              AutomationProperties.AutomationId="Browser.Forward" AutomationProperties.Name="{x:Static res:Strings.Forward}" />
      <Button DockPanel.Dock="Left" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.Refresh}"
              ToolTip="{x:Static res:Strings.Reload}" Command="{Binding ReloadCommand}"
              AutomationProperties.AutomationId="Browser.Reload" AutomationProperties.Name="{x:Static res:Strings.Reload}" />
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.ArrowRight}"
              ToolTip="{x:Static res:Strings.Go}" Command="{Binding GoCommand}"
              AutomationProperties.AutomationId="Browser.Go" AutomationProperties.Name="{x:Static res:Strings.Go}" />
      <TextBox x:Name="AddressBox" Margin="4,0" Style="{StaticResource TextBox.Field}"
               Tag="{x:Static res:Strings.AddressPlaceholder}"
               Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="{Binding Title}"
               AutomationProperties.AutomationId="Browser.Address" AutomationProperties.Name="{x:Static res:Strings.Address}">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding GoCommand}" />
        </TextBox.InputBindings>
      </TextBox>
    </DockPanel>
    <TextBlock DockPanel.Dock="Top" Margin="8,0,8,4" TextWrapping="Wrap"
               Foreground="{DynamicResource Brush.Error.Foreground}" Text="{Binding Error}"
               Visibility="{Binding Error, Converter={x:Static controls:NullToCollapsedConverter.Instance}}"
               AutomationProperties.AutomationId="Browser.Error" />
    <ContentControl x:Name="Host" Focusable="False" />
  </DockPanel>
</UserControl>
