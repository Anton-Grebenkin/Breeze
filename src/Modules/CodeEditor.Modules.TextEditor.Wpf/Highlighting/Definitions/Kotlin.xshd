<?xml version="1.0"?>
<!--
  Kotlin: comments (block comments nest), "…" and """…""" strings with $name and ${expression} templates, chars,
  annotations, keywords and modifiers, capitalized classes, function calls, numbers. Member access
  (list.data, it.open) is not a keyword. Color names are theme tokens (ADR 0036).
-->
<SyntaxDefinition name="Kotlin" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" />
  <Color name="String" />
  <Color name="Number" />
  <Color name="Keyword" />
  <Color name="ControlKeyword" />
  <Color name="Function" />
  <Color name="Type" />
  <Color name="Variable" />
  <Color name="Text" />

  <RuleSet>
    <Span color="Comment" begin="//" />
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" ruleSet="BlockComment" />
    <Span color="String" multiline="true" begin="&quot;&quot;&quot;" end="&quot;&quot;&quot;(?!&quot;)" ruleSet="Template" />
    <Span color="String" begin="&quot;" end="&quot;" ruleSet="EscapedTemplate" />
    <Rule color="String">'(?:\\(?:[tbnr'&quot;\\$]|u[\da-fA-F]{4})|[^'\\])'</Rule>
    <Rule color="Type">@(?:file:|field:|get:|set:|param:|property:|receiver:|delegate:)?[A-Za-z_]\w*</Rule>

    <Rule color="Function">(?&lt;=(?&lt;!\.)\.)(?&gt;[A-Za-z_]\w*)(?=\s*[({])</Rule>
    <Rule>(?&lt;!\.)\.(?&gt;[A-Za-z_]\w*)(?!\s*[({])</Rule>

    <Keywords color="ControlKeyword">
      <Word>if</Word>
      <Word>else</Word>
      <Word>when</Word>
      <Word>for</Word>
      <Word>while</Word>
      <Word>do</Word>
      <Word>break</Word>
      <Word>continue</Word>
      <Word>return</Word>
      <Word>throw</Word>
      <Word>try</Word>
      <Word>catch</Word>
      <Word>finally</Word>
    </Keywords>
    <Keywords color="Keyword">
      <Word>as</Word>
      <Word>class</Word>
      <Word>fun</Word>
      <Word>in</Word>
      <Word>is</Word>
      <Word>interface</Word>
      <Word>object</Word>
      <Word>package</Word>
      <Word>import</Word>
      <Word>super</Word>
      <Word>this</Word>
      <Word>typealias</Word>
      <Word>val</Word>
      <Word>var</Word>
      <Word>null</Word>
      <Word>true</Word>
      <Word>false</Word>
      <Word>by</Word>
      <Word>constructor</Word>
      <Word>init</Word>
      <Word>where</Word>
      <Word>companion</Word>
      <Word>data</Word>
      <Word>enum</Word>
      <Word>sealed</Word>
      <Word>abstract</Word>
      <Word>open</Word>
      <Word>override</Word>
      <Word>private</Word>
      <Word>protected</Word>
      <Word>public</Word>
      <Word>internal</Word>
      <Word>inline</Word>
      <Word>suspend</Word>
      <Word>operator</Word>
      <Word>infix</Word>
      <Word>lateinit</Word>
      <Word>const</Word>
      <Word>vararg</Word>
      <Word>reified</Word>
      <Word>crossinline</Word>
      <Word>noinline</Word>
      <Word>tailrec</Word>
      <Word>external</Word>
      <Word>annotation</Word>
      <Word>inner</Word>
      <Word>actual</Word>
      <Word>expect</Word>
    </Keywords>
    <Rule color="Type">\b(?=[A-Z]\w*[a-z])[A-Z]\w*</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*(?:&lt;[^&lt;&gt;()]*(?:&lt;[^&lt;&gt;()]*&gt;[^&lt;&gt;()]*)*&gt;\s*)?\()</Rule>
    <Rule color="Number">
      \b(?:0[xX][\da-fA-F_]+|0[bB][01_]+|\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d+)?)(?:[fFdD]|[uU]?[lL]?)\b
    </Rule>
  </RuleSet>

  <RuleSet name="BlockComment">
    <Span multiline="true" begin="/\*" end="\*/" ruleSet="BlockComment" />
  </RuleSet>

  <RuleSet name="EscapedTemplate">
    <Span begin="\\" end="." />
    <Import ruleSet="Template" />
  </RuleSet>

  <!-- $name and ${expression}: the code inside uses the text color. -->
  <RuleSet name="Template">
    <Span color="Text" multiline="true" ruleSet="Code">
      <Begin color="Keyword">\$\{</Begin>
      <End color="Keyword">\}</End>
    </Span>
    <Rule color="Variable">\$[A-Za-z_]\w*</Rule>
  </RuleSet>

  <RuleSet name="Code">
    <Span multiline="true" begin="\{" end="\}" ruleSet="Code" />
    <Import ruleSet="" />
  </RuleSet>
</SyntaxDefinition>
