<?xml version="1.0"?>
<!--
  F#: // and nested (* … *) comments ((*) is an operator, not a comment), regular, @"…", """…""" and interpolated
  $"…{expression}…" strings, chars, type parameters 'T, attributes [<…>], directives #if, #r, #load. Keywords
  including let! and use!; built-in types; member names after member. Color names are theme tokens (ADR 0036).
-->
<SyntaxDefinition name="FSharp" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" />
  <Color name="String" />
  <Color name="Number" />
  <Color name="Keyword" />
  <Color name="ControlKeyword" />
  <Color name="Function" />
  <Color name="Type" />
  <Color name="Preprocessor" />
  <Color name="Text" />

  <RuleSet>
    <Span color="Comment" begin="//" />
    <Span color="Comment" multiline="true" begin="\(\*(?!\))" end="\*\)" ruleSet="BlockComment" />
    <Span color="String" multiline="true" begin="\$&quot;&quot;&quot;" end="&quot;&quot;&quot;" ruleSet="Interpolated" />
    <Span color="String" multiline="true" begin="&quot;&quot;&quot;" end="&quot;&quot;&quot;" />
    <Span color="String" multiline="true" begin="@&quot;" end="&quot;" ruleSet="Verbatim" />
    <Span color="String" multiline="true" begin="\$&quot;" end="&quot;" ruleSet="Interpolated" />
    <Span color="String" multiline="true" begin="&quot;" end="&quot;B?" ruleSet="Escapes" />

    <Rule color="String">'(?:\\(?:[ntbrafv\\'&quot;0]|u[\da-fA-F]{4}|U[\da-fA-F]{8}|\d{3})|[^'\\])'B?</Rule>
    <Rule color="Type">'[A-Za-z_]\w*</Rule>
    <Rule color="Preprocessor">^\s*\#(?:if|else|endif|nowarn|r|load|light|I|time|help|quit|line|indent)\b[^&quot;]*</Rule>
    <Rule color="Type">\[&lt;.*?&gt;\]</Rule>

    <Keywords color="ControlKeyword">
      <Word>yield!</Word>
      <Word>return!</Word>
      <Word>match!</Word>
      <Word>do!</Word>
    </Keywords>
    <Keywords color="Keyword">
      <Word>let!</Word>
      <Word>use!</Word>
      <Word>and!</Word>
    </Keywords>
    <Keywords color="ControlKeyword">
      <Word>if</Word>
      <Word>then</Word>
      <Word>elif</Word>
      <Word>else</Word>
      <Word>match</Word>
      <Word>with</Word>
      <Word>when</Word>
      <Word>for</Word>
      <Word>to</Word>
      <Word>downto</Word>
      <Word>while</Word>
      <Word>do</Word>
      <Word>done</Word>
      <Word>try</Word>
      <Word>finally</Word>
      <Word>return</Word>
      <Word>yield</Word>
      <Word>raise</Word>
      <Word>failwith</Word>
    </Keywords>
    <Keywords color="Keyword">
      <Word>let</Word>
      <Word>rec</Word>
      <Word>and</Word>
      <Word>in</Word>
      <Word>mutable</Word>
      <Word>fun</Word>
      <Word>function</Word>
      <Word>type</Word>
      <Word>of</Word>
      <Word>open</Word>
      <Word>module</Word>
      <Word>namespace</Word>
      <Word>member</Word>
      <Word>override</Word>
      <Word>abstract</Word>
      <Word>default</Word>
      <Word>static</Word>
      <Word>val</Word>
      <Word>new</Word>
      <Word>inherit</Word>
      <Word>interface</Word>
      <Word>class</Word>
      <Word>struct</Word>
      <Word>end</Word>
      <Word>begin</Word>
      <Word>inline</Word>
      <Word>private</Word>
      <Word>public</Word>
      <Word>internal</Word>
      <Word>as</Word>
      <Word>assert</Word>
      <Word>base</Word>
      <Word>global</Word>
      <Word>extern</Word>
      <Word>lazy</Word>
      <Word>not</Word>
      <Word>null</Word>
      <Word>true</Word>
      <Word>false</Word>
      <Word>upcast</Word>
      <Word>downcast</Word>
      <Word>exception</Word>
      <Word>delegate</Word>
      <Word>use</Word>
      <Word>const</Word>
    </Keywords>
    <Keywords color="Type">
      <Word>int</Word>
      <Word>string</Word>
      <Word>bool</Word>
      <Word>float</Word>
      <Word>double</Word>
      <Word>decimal</Word>
      <Word>char</Word>
      <Word>byte</Word>
      <Word>sbyte</Word>
      <Word>int8</Word>
      <Word>int16</Word>
      <Word>int32</Word>
      <Word>int64</Word>
      <Word>uint8</Word>
      <Word>uint16</Word>
      <Word>uint32</Word>
      <Word>uint64</Word>
      <Word>nativeint</Word>
      <Word>unativeint</Word>
      <Word>unit</Word>
      <Word>obj</Word>
      <Word>exn</Word>
      <Word>list</Word>
      <Word>seq</Word>
      <Word>option</Word>
      <Word>voption</Word>
      <Word>array</Word>
      <Word>float32</Word>
      <Word>single</Word>
      <Word>bigint</Word>
    </Keywords>
    <!-- Member name: member this.Area, override _.ToString(). -->
    <Rule color="Function">(?&lt;=\b(?:member|override|abstract|default)\s+(?:\w+\.)?)(?&gt;[A-Za-z_]\w*)(?![.\w])</Rule>
    <Rule color="Number">
      \b(?:0[xX][\da-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d+)?)(?:[a-zA-Z]{1,2})?\b
    </Rule>
  </RuleSet>

  <RuleSet name="BlockComment">
    <Span multiline="true" begin="\(\*(?!\))" end="\*\)" ruleSet="BlockComment" />
  </RuleSet>

  <RuleSet name="Escapes">
    <Span begin="\\" end="." />
  </RuleSet>

  <!-- @"…": quotes are doubled -->
  <RuleSet name="Verbatim">
    <Span begin="&quot;&quot;" end="" />
  </RuleSet>

  <!-- $"…{expression}…": {{ is a literal brace. -->
  <RuleSet name="Interpolated">
    <Span begin="\\" end="." />
    <Span begin="\{\{" end="" />
    <Span color="Text" multiline="true" ruleSet="Code">
      <Begin color="Keyword">\{</Begin>
      <End color="Keyword">\}</End>
    </Span>
  </RuleSet>

  <RuleSet name="Code">
    <Span multiline="true" begin="\{" end="\}" ruleSet="Code" />
    <Import ruleSet="" />
  </RuleSet>
</SyntaxDefinition>
