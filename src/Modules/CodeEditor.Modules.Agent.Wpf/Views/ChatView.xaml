<UserControl x:Class="CodeEditor.Modules.Agent.Wpf.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:chat="clr-namespace:CodeEditor.Modules.Agent.ViewModels.Chat;assembly=CodeEditor.Modules.Agent"
             xmlns:composer="clr-namespace:CodeEditor.Modules.Agent.ViewModels.Composer;assembly=CodeEditor.Modules.Agent"
             xmlns:tools="clr-namespace:CodeEditor.Modules.Agent.Services.Tools;assembly=CodeEditor.Modules.Agent"
             xmlns:views="clr-namespace:CodeEditor.Modules.Agent.Wpf.Views"
             xmlns:ui="clr-namespace:CodeEditor.UI.Themes;assembly=CodeEditor.UI"
             xmlns:controls="clr-namespace:CodeEditor.UI.Controls;assembly=CodeEditor.UI"
             xmlns:res="clr-namespace:CodeEditor.Modules.Agent.Resources;assembly=CodeEditor.Modules.Agent"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=chat:ChatViewModel}"
             AutomationProperties.AutomationId="Agent">
  <UserControl.Resources>
    <ResourceDictionary Source="ChatTemplates.xaml" />
  </UserControl.Resources>

  <Grid>
  <DockPanel>
    <!-- Header: chat title, history, new chat, more. -->
    <DockPanel DockPanel.Dock="Top" Margin="12,0,4,4" MinHeight="24">
      <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.More}"
              ToolTip="{x:Static res:Strings.MoreActions}" Click="OnMoreClick"
              AutomationProperties.AutomationId="Agent.More" AutomationProperties.Name="{x:Static res:Strings.MoreActions}">
        <Button.ContextMenu>
          <ContextMenu Placement="Bottom" AutomationProperties.AutomationId="Agent.MoreMenu">
            <MenuItem Style="{StaticResource MenuItem.Base}" Header="{x:Static res:Strings.CommandCopyLastAnswer}" Command="{Binding CopyLastAnswerCommand}"
                      AutomationProperties.AutomationId="Agent.More.CopyLastAnswer" />
            <MenuItem Style="{StaticResource MenuItem.Base}" Header="{x:Static res:Strings.CommandDeleteChat}" Command="{Binding DeleteChatCommand}"
                      AutomationProperties.AutomationId="Agent.More.DeleteChat" />
          </ContextMenu>
        </Button.ContextMenu>
      </Button>
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.Add}" ToolTip="{x:Static res:Strings.NewChat}"
              Command="{Binding NewChatCommand}" AutomationProperties.AutomationId="Agent.NewChat" AutomationProperties.Name="{x:Static res:Strings.NewChat}" />
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.History}" ToolTip="{x:Static res:Strings.CommandShowHistory}"
              Command="{Binding ShowHistoryCommand}" AutomationProperties.AutomationId="Agent.History" AutomationProperties.Name="{x:Static res:Strings.ChatHistory}" />
      <TextBlock VerticalAlignment="Center"
                 TextTrimming="CharacterEllipsis"
                 FontSize="{DynamicResource FontSize.Small}"
                 Foreground="{DynamicResource Brush.Text.Secondary}"
                 Text="{Binding Title}"
                 ToolTip="{Binding Title}"
                 AutomationProperties.AutomationId="Agent.Title" />
    </DockPanel>

    <views:ChatComposer x:Name="Composer" DockPanel.Dock="Bottom" Margin="8,4,8,8" />

    <!-- Agent edits above the input: "2 files changed +5 −1", accept or revert; per file: diff and revert. -->
    <controls:AutomationBorder DockPanel.Dock="Bottom" Margin="8,4,8,0" Padding="8,4" CornerRadius="6" BorderThickness="1"
                               DataContext="{Binding Changes}"
                               BorderBrush="{DynamicResource Brush.Widget.Border}"
                               Background="{DynamicResource Brush.Widget.Background}"
                               Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.AutomationId="Agent.Changes">
      <StackPanel>
        <DockPanel>
          <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,2" Style="{StaticResource Button.Subtle}" Content="{x:Static res:Strings.RevertAll}"
                  ToolTip="{x:Static res:Strings.RevertAllToolTip}" Command="{Binding RevertAllCommand}"
                  AutomationProperties.AutomationId="Agent.Changes.RevertAll" />
          <Button DockPanel.Dock="Right" Padding="8,2" Style="{StaticResource Button.Primary}" Content="{x:Static res:Strings.Accept}"
                  ToolTip="{x:Static res:Strings.AcceptToolTip}" Command="{Binding AcceptCommand}"
                  AutomationProperties.AutomationId="Agent.Changes.Accept" />
          <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,2" Style="{StaticResource Button.Subtle}"
                  Command="{Binding ToggleCommand}" AutomationProperties.AutomationId="Agent.Changes.Toggle" AutomationProperties.Name="{Binding Title}">
            <StackPanel Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Icons}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="{x:Static ui:IconGlyphs.ChevronRight}" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter Property="Text" Value="{x:Static ui:IconGlyphs.ChevronDown}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlock.Note}" FontWeight="SemiBold" Text="{Binding Title}" />
              <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlock.Note}" Text="{Binding Counts}" />
            </StackPanel>
          </Button>
        </DockPanel>
        <ItemsControl Margin="0,2,0,2" ItemsSource="{Binding Files}" Focusable="False"
                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type composer:ChangedFileViewModel}">
              <StackPanel>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.Discard}" ToolTip="{x:Static res:Strings.RevertFile}"
                          Command="{Binding DataContext.RevertFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                          AutomationProperties.AutomationId="Agent.Changes.Revert" AutomationProperties.Name="{Binding Change.RelativePath, StringFormat={x:Static res:Strings.RevertFileName}}" />
                  <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.Diff}" ToolTip="{x:Static res:Strings.ShowDiff}"
                                IsChecked="{Binding IsDiffVisible}"
                                AutomationProperties.AutomationId="Agent.Changes.Diff" AutomationProperties.Name="{Binding Change.RelativePath, StringFormat={x:Static res:Strings.DiffFileName}}" />
                  <Button Padding="16,2,4,2" HorizontalContentAlignment="Left" Style="{StaticResource Button.Subtle}" ToolTip="{Binding Change.RelativePath}"
                          Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                          AutomationProperties.AutomationId="Agent.Changes.File" AutomationProperties.Name="{Binding Change.RelativePath}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding Name}" />
                      <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlock.Note}" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Warning.Foreground}" FontSize="{DynamicResource FontSize.Small}" Text="{Binding Status}" />
                      <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlock.Note}" Text="{Binding Diff.Counts}" />
                    </StackPanel>
                  </Button>
                </DockPanel>
                <ScrollViewer MaxHeight="240" Margin="16,2,0,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsDiffVisible, Converter={StaticResource BoolToVisibility}}">
                  <ItemsControl ItemsSource="{Binding Diff.Lines}" ItemTemplate="{StaticResource DiffLineTemplate}" Focusable="False"
                                FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Small}"
                                AutomationProperties.AutomationId="Agent.Changes.DiffLines" />
                </ScrollViewer>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </controls:AutomationBorder>

    <!-- Agent plan above the input: "Plan · 2 of 5" with checkmarks; collapsible. -->
    <controls:AutomationBorder DockPanel.Dock="Bottom" Margin="8,4,8,0" Padding="8,4" CornerRadius="6" BorderThickness="1"
                               DataContext="{Binding Todo}"
                               BorderBrush="{DynamicResource Brush.Widget.Border}"
                               Background="{DynamicResource Brush.Widget.Background}"
                               Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.AutomationId="Agent.Todo">
      <StackPanel>
        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="0,2" Style="{StaticResource Button.Subtle}"
                Command="{Binding ToggleCommand}" AutomationProperties.AutomationId="Agent.Todo.Toggle" AutomationProperties.Name="{Binding Title}">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="TodoChevron" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text.Secondary}" FontFamily="{DynamicResource Font.Icons}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{x:Static ui:IconGlyphs.ChevronRight}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                      <Setter Property="Text" Value="{x:Static ui:IconGlyphs.ChevronDown}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlock.Note}" FontWeight="SemiBold" Text="{Binding Title}" />
          </StackPanel>
        </Button>
        <ItemsControl Margin="16,2,0,2" ItemsSource="{Binding Items}" Focusable="False"
                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type tools:TodoItem}">
              <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock x:Name="Mark" Width="18" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Icons}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" Text="{x:Static ui:IconGlyphs.Circle}" />
                <TextBlock x:Name="ItemTitle" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Text.Primary}" Text="{Binding Title}" />
              </StackPanel>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="InProgress">
                  <Setter TargetName="Mark" Property="Text" Value="{x:Static ui:IconGlyphs.CircleFilled}" />
                  <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                  <Setter TargetName="ItemTitle" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Completed">
                  <Setter TargetName="Mark" Property="Text" Value="{x:Static ui:IconGlyphs.Check}" />
                  <Setter TargetName="ItemTitle" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                  <Setter TargetName="ItemTitle" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </controls:AutomationBorder>

    <Grid>
      <!-- No key: a hint instead of an empty chat. -->
      <StackPanel Margin="12,8"
                  Visibility="{Binding HasApiKey, Converter={x:Static controls:InverseBoolToVisibilityConverter.Instance}}">
        <TextBlock TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="{x:Static res:Strings.ApiKeyMissing}" />
        <Button Margin="0,12,0,0"
                HorizontalAlignment="Stretch"
                Style="{StaticResource Button.CommandCenter}"
                Content="{x:Static res:Strings.CommandSetApiKey}"
                Command="{Binding SetApiKeyCommand}"
                AutomationProperties.AutomationId="Agent.SetApiKey" />
      </StackPanel>

      <ScrollViewer x:Name="MessagesScroll"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding HasApiKey, Converter={StaticResource BoolToVisibility}}">
        <ItemsControl x:Name="MessageList"
                      ItemsSource="{Binding Feed.Items}"
                      ItemTemplateSelector="{StaticResource FeedTemplateSelector}"
                      FontSize="{DynamicResource FontSize.Chat}"
                      Focusable="False"
                      AutomationProperties.AutomationId="Agent.Messages" />
      </ScrollViewer>

      <!-- Empty chat: what the agent can do and the folder's recent chats. -->
      <controls:AutomationBorder Margin="12,16,8,8" VerticalAlignment="Top"
                                 Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.AutomationId="Agent.Welcome">
      <StackPanel>
        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text.Primary}" Text="{x:Static res:Strings.WelcomeTitle}" />
        <TextBlock Margin="0,4,0,0" Style="{StaticResource TextBlock.Note}"
                   Text="{x:Static res:Strings.WelcomeText}" />
        <TextBlock Margin="0,8,0,0" Style="{StaticResource TextBlock.Note}" Text="{x:Static res:Strings.WelcomeOpenFolder}"
                   Visibility="{Binding HasWorkspace, Converter={x:Static controls:InverseBoolToVisibilityConverter.Instance}}" />
        <StackPanel Margin="0,16,0,0" Visibility="{Binding HasRecentChats, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Margin="0,0,0,4" Style="{StaticResource TextBlock.Note}" FontWeight="SemiBold" Text="{x:Static res:Strings.RecentChats}" />
          <ItemsControl ItemsSource="{Binding RecentChats}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type chat:RecentChat}">
                <Button Margin="-4,0,0,0" Padding="4,3" HorizontalContentAlignment="Stretch" Style="{StaticResource Button.Subtle}"
                        Command="{Binding DataContext.OpenChatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding Id}"
                        AutomationProperties.AutomationId="Agent.RecentChat"
                        AutomationProperties.Name="{Binding Title}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource TextBlock.Note}" Text="{Binding When}" />
                    <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Margin="-4,4,0,0" Padding="4,3" HorizontalAlignment="Left" Style="{StaticResource Button.Subtle}"
                  Foreground="{DynamicResource Brush.Markdown.Link}" Content="{x:Static res:Strings.AllFolderChats}"
                  Command="{Binding ShowHistoryCommand}" AutomationProperties.AutomationId="Agent.AllChats" />
        </StackPanel>
      </StackPanel>
      </controls:AutomationBorder>

    </Grid>
  </DockPanel>

  <!-- The model manager over the chat; Esc or Back returns to the chat. -->
  <views:ModelManagerView DataContext="{Binding Model.Manager}"
                          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}" />
  </Grid>
</UserControl>
