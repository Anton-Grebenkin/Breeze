<UserControl x:Class="CodeEditor.Modules.Agent.Wpf.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:CodeEditor.Modules.Agent.ViewModels.Models;assembly=CodeEditor.Modules.Agent"
             xmlns:ui="clr-namespace:CodeEditor.UI.Themes;assembly=CodeEditor.UI"
             xmlns:controls="clr-namespace:CodeEditor.UI.Controls;assembly=CodeEditor.UI"
             xmlns:res="clr-namespace:CodeEditor.Modules.Agent.Resources;assembly=CodeEditor.Modules.Agent"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=models:ConnectionsViewModel}"
             Background="{DynamicResource Brush.Window.Background}"
             AutomationProperties.AutomationId="Agent.Connections">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ChatTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- A model of a connection: the switch puts it into the model picker; a switched-on model can be described. -->
      <DataTemplate x:Key="Connection.Model" DataType="{x:Type models:ConnectionModelRowViewModel}">
        <StackPanel Margin="0,2">
          <DockPanel MinHeight="24">
            <ToggleButton DockPanel.Dock="Left" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource ToggleButton.Switch}"
                          IsChecked="{Binding IsEnabled}" ToolTip="{x:Static res:Strings.ModelInPicker}"
                          AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Model.{0}}" AutomationProperties.Name="{Binding Id}" />
            <Button x:Name="UseButton" DockPanel.Dock="Right" Padding="8,1" Style="{StaticResource Button.Secondary}"
                    Content="{x:Static res:Strings.ModelUse}" ToolTip="{x:Static res:Strings.ModelUseHint}" Command="{Binding UseCommand}"
                    AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Use.{0}}" />
            <TextBlock x:Name="Current" DockPanel.Dock="Right" Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource TextBlock.Note}"
                       Text="{x:Static res:Strings.ModelsCurrent}" Visibility="Collapsed" />
            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Id}" ToolTip="{Binding Id}" />
          </DockPanel>
          <!-- Two lines: the panel is narrow, and a name needs room. -->
          <StackPanel Margin="36,2,0,4" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <Button DockPanel.Dock="Left" Margin="0,0,4,0" Padding="8,2" Style="{StaticResource Button.Secondary}"
                      Content="{Binding FamilyTitle}" ToolTip="{x:Static res:Strings.ModelFamilyHint}" Click="OnMenuButtonClick"
                      AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Family.{0}}" AutomationProperties.Name="{x:Static res:Strings.ModelFamilyHint}">
                <Button.ContextMenu>
                  <ContextMenu ItemsSource="{Binding FamilyMenu}" ItemContainerStyle="{StaticResource MenuItem.Bound}"
                               AutomationProperties.AutomationId="Agent.Connections.FamilyMenu" />
                </Button.ContextMenu>
              </Button>
              <TextBox Style="{StaticResource TextBox.Field}"
                       Tag="{x:Static res:Strings.ModelNamePlaceholder}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                       AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Name.{0}}" AutomationProperties.Name="{x:Static res:Strings.ModelNamePlaceholder}" />
            </DockPanel>
            <DockPanel Margin="0,4,0,0">
              <TextBox DockPanel.Dock="Left" Width="120" Style="{StaticResource TextBox.Field}"
                       Tag="{x:Static res:Strings.ModelWindowPlaceholder}" Text="{Binding ContextWindow, UpdateSourceTrigger=LostFocus}"
                       AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Window.{0}}" AutomationProperties.Name="{x:Static res:Strings.ModelWindowPlaceholder}" />
              <ToggleButton DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource ToggleButton.Switch}"
                            IsChecked="{Binding Images}" ToolTip="{x:Static res:Strings.ModelImagesHint}"
                            AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Images.{0}}" AutomationProperties.Name="{x:Static res:Strings.ModelImagesHint}" />
              <Button DockPanel.Dock="Right" Padding="8,1" Style="{StaticResource Button.Secondary}"
                      Content="{x:Static res:Strings.ModelCheck}" ToolTip="{x:Static res:Strings.ModelCheckHint}" Command="{Binding CheckCommand}"
                      AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Check.{0}}" />
              <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlock.Note}" TextWrapping="NoWrap" Text="{x:Static res:Strings.ModelImages}" />
            </DockPanel>
            <!-- The model check: a line per probe, and a button that writes the findings into the settings. -->
            <TextBlock Margin="0,4,0,0" Style="{StaticResource TextBlock.Note}" Text="{x:Static res:Strings.ModelChecking}"
                       Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}"
                       AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Checking.{0}}" />
            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Report}" Focusable="False"
                          AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Report.{0}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:ModelProbeLine}">
                  <DockPanel Margin="0,1">
                    <TextBlock x:Name="Mark" DockPanel.Dock="Left" Width="18" FontFamily="{DynamicResource Font.Icons}"
                               Foreground="{DynamicResource Brush.Text.Secondary}" Text="{x:Static ui:IconGlyphs.CircleSmallFilled}" />
                    <TextBlock x:Name="Line" Style="{StaticResource TextBlock.Note}"
                               AutomationProperties.AutomationId="{Binding Kind, StringFormat=Agent.Connections.Probe.{0}}">
                      <Run FontWeight="SemiBold" Text="{Binding Title, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Detail, Mode=OneWay}" />
                    </TextBlock>
                  </DockPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsPassed}" Value="True">
                      <Setter TargetName="Mark" Property="Text" Value="{x:Static ui:IconGlyphs.Check}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                      <Setter TargetName="Mark" Property="Text" Value="{x:Static ui:IconGlyphs.Error}" />
                      <Setter TargetName="Line" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Margin="0,4,0,0" Padding="8,1" HorizontalAlignment="Left" Style="{StaticResource Button.Secondary}"
                    Content="{x:Static res:Strings.ModelApplyCheck}" ToolTip="{x:Static res:Strings.ModelApplyCheckHint}" Command="{Binding ApplyCheckCommand}"
                    Visibility="{Binding CanApplyCheck, Converter={StaticResource BoolToVisibility}}"
                    AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.ApplyCheck.{0}}" />
          </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsCurrent}" Value="True">
            <Setter TargetName="UseButton" Property="Visibility" Value="Collapsed" />
            <Setter TargetName="Current" Property="Visibility" Value="Visible" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- A connection: a header that expands its models, the key, refresh and removal. -->
      <DataTemplate x:Key="Connection.Row" DataType="{x:Type models:ConnectionRowViewModel}">
        <StackPanel Margin="0,4,0,0">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.Delete}"
                    ToolTip="{x:Static res:Strings.ConnectionRemove}" Command="{Binding RemoveCommand}"
                    AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Remove.{0}}" AutomationProperties.Name="{x:Static res:Strings.ConnectionRemove}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.Refresh}"
                    ToolTip="{x:Static res:Strings.ConnectionRefresh}" Command="{Binding RefreshCommand}"
                    AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Refresh.{0}}" AutomationProperties.Name="{x:Static res:Strings.ConnectionRefresh}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.Shield}"
                    ToolTip="{x:Static res:Strings.ConnectionSetKey}" Command="{Binding SetKeyCommand}"
                    AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Key.{0}}" AutomationProperties.Name="{x:Static res:Strings.ConnectionSetKey}" />
            <ToggleButton Padding="4,3" HorizontalContentAlignment="Stretch" Style="{StaticResource Button.Subtle}"
                          IsChecked="{Binding IsExpanded}" ToolTip="{Binding Endpoint}"
                          AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Row.{0}}" AutomationProperties.Name="{Binding Title}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextBlock.Note}" VerticalAlignment="Center" TextWrapping="NoWrap" Text="{Binding KeyText}" />
                <TextBlock x:Name="Chevron" Width="18" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Icons}"
                           Foreground="{DynamicResource Brush.Text.Secondary}" Text="{x:Static ui:IconGlyphs.ChevronRight}" />
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
              </DockPanel>
            </ToggleButton>
          </DockPanel>
          <StackPanel Margin="22,4,0,0" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,2" Style="{StaticResource Button.Secondary}"
                      Content="{x:Static res:Strings.ModelsAddCustom}" ToolTip="{x:Static res:Strings.ConnectionAddModelHint}" Command="{Binding AddModelCommand}"
                      AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.AddModel.{0}}" />
              <TextBox Style="{StaticResource TextBox.Field}"
                       Tag="{x:Static res:Strings.ConnectionFilterPlaceholder}" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                       AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Filter.{0}}" AutomationProperties.Name="{x:Static res:Strings.ConnectionFilterPlaceholder}" />
            </DockPanel>
            <ListBox Margin="0,4,0,0" MaxHeight="320" ItemsSource="{Binding Models}" Style="{StaticResource ListBox.Results}"
                     ItemTemplate="{StaticResource Connection.Model}" HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Models.{0}}" />
            <TextBlock Margin="0,4,0,0" Style="{StaticResource TextBlock.Note}" Text="{Binding Status}"
                       AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Connections.Status.{0}}" />
          </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsExpanded}" Value="True">
            <Setter TargetName="Chevron" Property="Text" Value="{x:Static ui:IconGlyphs.ChevronDown}" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel Margin="8,0,8,8">
    <!-- Header: back to chat and the title. -->
    <DockPanel DockPanel.Dock="Top" MinHeight="24">
      <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.ArrowLeft}"
              ToolTip="{x:Static res:Strings.ModelsBack}" Command="{Binding CloseCommand}"
              AutomationProperties.AutomationId="Agent.Connections.Back" AutomationProperties.Name="{x:Static res:Strings.ModelsBack}" />
      <TextBlock Margin="4,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Static res:Strings.ConnectionsTitle}" />
    </DockPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="0,0,4,0">
        <TextBlock Margin="4,4,4,4" Style="{StaticResource TextBlock.Note}" Text="{x:Static res:Strings.ConnectionsHint}" />
        <TextBlock Margin="4,4" Style="{StaticResource TextBlock.Note}" Text="{x:Static res:Strings.ConnectionsEmpty}"
                   Visibility="{Binding HasConnections, Converter={x:Static controls:InverseBoolToVisibilityConverter.Instance}}"
                   AutomationProperties.AutomationId="Agent.Connections.Empty" />
        <ItemsControl ItemsSource="{Binding Connections}" ItemTemplate="{StaticResource Connection.Row}" Focusable="False"
                      AutomationProperties.AutomationId="Agent.Connections.List" />

        <!-- Add a connection: the address is asked for its model list before anything is saved. -->
        <TextBlock Margin="4,16,4,4" FontWeight="SemiBold" Text="{x:Static res:Strings.ConnectionAddTitle}" />
        <TextBox x:Name="NameBox" Margin="0,2" Style="{StaticResource TextBox.Field}"
                 Tag="{x:Static res:Strings.ConnectionNamePlaceholder}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="Agent.Connections.New.Name" AutomationProperties.Name="{x:Static res:Strings.ConnectionNamePlaceholder}" />
        <TextBox Margin="0,2" Style="{StaticResource TextBox.Field}"
                 Tag="{x:Static res:Strings.ConnectionEndpointPlaceholder}" Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="Agent.Connections.New.Endpoint" AutomationProperties.Name="{x:Static res:Strings.ConnectionEndpointPlaceholder}" />
        <DockPanel Margin="0,2">
          <TextBlock DockPanel.Dock="Left" Width="72" Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlock.Note}"
                     TextWrapping="NoWrap" Text="{x:Static res:Strings.ConnectionKeyPlaceholder}" />
          <TextBlock DockPanel.Dock="Right" Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource TextBlock.Note}"
                     TextWrapping="NoWrap" Text="{x:Static res:Strings.ConnectionKeylessCheck}" />
          <ToggleButton DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ToggleButton.Switch}"
                        IsChecked="{Binding IsKeyless}" ToolTip="{x:Static res:Strings.ConnectionKeylessHint}"
                        AutomationProperties.AutomationId="Agent.Connections.New.Keyless" AutomationProperties.Name="{x:Static res:Strings.ConnectionKeylessHint}" />
          <PasswordBox x:Name="KeyBox" Style="{StaticResource PasswordBox.Field}" PasswordChanged="OnKeyChanged"
                       AutomationProperties.AutomationId="Agent.Connections.New.Key" AutomationProperties.Name="{x:Static res:Strings.ConnectionKeyPlaceholder}" />
        </DockPanel>
        <WrapPanel Margin="0,6,0,0">
          <Button Padding="12,3" Style="{StaticResource Button.Primary}" IsDefault="True"
                  Content="{x:Static res:Strings.ConnectionCheckAndAdd}" Command="{Binding AddCommand}"
                  AutomationProperties.AutomationId="Agent.Connections.New.Add" />
          <Button Margin="8,0,0,0" Padding="12,3" Style="{StaticResource Button.Secondary}"
                  Content="{x:Static res:Strings.ConnectionAddUnchecked}" Command="{Binding AddUncheckedCommand}"
                  Visibility="{Binding CanSkipCheck, Converter={StaticResource BoolToVisibility}}"
                  AutomationProperties.AutomationId="Agent.Connections.New.AddUnchecked" />
        </WrapPanel>
        <TextBlock Margin="4,6,4,0" Style="{StaticResource TextBlock.Note}" Text="{Binding Status}"
                   AutomationProperties.AutomationId="Agent.Connections.New.Status" />
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
