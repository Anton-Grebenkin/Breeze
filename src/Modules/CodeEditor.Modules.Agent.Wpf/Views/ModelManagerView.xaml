<UserControl x:Class="CodeEditor.Modules.Agent.Wpf.Views.ModelManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:CodeEditor.Modules.Agent.ViewModels.Models;assembly=CodeEditor.Modules.Agent"
             xmlns:ui="clr-namespace:CodeEditor.UI.Themes;assembly=CodeEditor.UI"
             xmlns:res="clr-namespace:CodeEditor.Modules.Agent.Resources;assembly=CodeEditor.Modules.Agent"
             xmlns:views="clr-namespace:CodeEditor.Modules.Agent.Wpf.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=models:ModelManagerViewModel}"
             Background="{DynamicResource Brush.Window.Background}"
             AutomationProperties.AutomationId="Agent.Models">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ChatTemplates.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- "Show in picker" switch: track and thumb, no animation. -->
      <Style x:Key="ToggleButton.Switch" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="Track" CornerRadius="8" BorderThickness="1"
                      BorderBrush="{DynamicResource Brush.Input.Border}" Background="{DynamicResource Brush.Input.Background}">
                <Ellipse x:Name="Thumb" Width="10" Height="10" Margin="3,0" HorizontalAlignment="Left"
                         Fill="{DynamicResource Brush.Text.Secondary}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                  <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                  <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                  <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Brush.Accent.Foreground}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Track" Property="Opacity" Value="0.6" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Focus.Border}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- Vendor: a button row that collapses the group. -->
      <DataTemplate x:Key="ModelRow.Vendor" DataType="{x:Type models:ModelRowViewModel}">
        <ToggleButton Margin="0,6,0,0" Padding="4,3" HorizontalContentAlignment="Stretch" Style="{StaticResource Button.Subtle}"
                      IsChecked="{Binding IsChecked}"
                      AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Models.Vendor.{0}}" AutomationProperties.Name="{Binding Title}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource TextBlock.Note}" VerticalAlignment="Center" Text="{Binding Detail}" />
            <TextBlock x:Name="Chevron" Width="18" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Icons}"
                       Foreground="{DynamicResource Brush.Text.Secondary}" Text="{x:Static ui:IconGlyphs.ChevronRight}" />
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}" />
          </DockPanel>
        </ToggleButton>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsChecked}" Value="True">
            <Setter TargetName="Chevron" Property="Text" Value="{x:Static ui:IconGlyphs.ChevronDown}" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Model: name, current mark and switch; the current model cannot be disabled. -->
      <DataTemplate x:Key="ModelRow.Model" DataType="{x:Type models:ModelRowViewModel}">
        <DockPanel Margin="22,1,4,1" MinHeight="24">
          <ToggleButton x:Name="Switch" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource ToggleButton.Switch}"
                        IsChecked="{Binding IsChecked}"
                        AutomationProperties.AutomationId="{Binding Id, StringFormat=Agent.Models.Toggle.{0}}" AutomationProperties.Name="{Binding Id}" />
          <TextBlock x:Name="Current" DockPanel.Dock="Right" Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource TextBlock.Note}"
                     Text="{x:Static res:Strings.ModelsCurrent}" Visibility="Collapsed" />
          <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" ToolTip="{Binding Id}" />
        </DockPanel>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsCurrent}" Value="True">
            <Setter TargetName="Switch" Property="IsEnabled" Value="False" />
            <Setter TargetName="Current" Property="Visibility" Value="Visible" />
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <views:ModelRowTemplateSelector x:Key="ModelRow.Selector" Vendor="{StaticResource ModelRow.Vendor}" Model="{StaticResource ModelRow.Model}" />
    </ResourceDictionary>
  </UserControl.Resources>

  <DockPanel Margin="8,0,8,8">
    <!-- Header: back to chat, title, refresh. -->
    <DockPanel DockPanel.Dock="Top" MinHeight="24">
      <Button DockPanel.Dock="Left" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.ArrowLeft}"
              ToolTip="{x:Static res:Strings.ModelsBack}" Command="{Binding CloseCommand}"
              AutomationProperties.AutomationId="Agent.Models.Back" AutomationProperties.Name="{x:Static res:Strings.ModelsBack}" />
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Toolbar}" Content="{x:Static ui:IconGlyphs.Refresh}"
              ToolTip="{x:Static res:Strings.ModelsRefresh}" Command="{Binding RefreshCommand}"
              AutomationProperties.AutomationId="Agent.Models.Refresh" AutomationProperties.Name="{x:Static res:Strings.ModelsRefresh}" />
      <TextBlock Margin="4,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Static res:Strings.ModelsTitle}" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Top" Margin="4,4,4,8" Style="{StaticResource TextBlock.Note}" Text="{x:Static res:Strings.ModelsHint}" />

    <!-- Search; a typed "vendor/model" missing from the list can be added. -->
    <DockPanel DockPanel.Dock="Top">
      <Button DockPanel.Dock="Right" Margin="4,0,0,0" Padding="8,2" Style="{StaticResource Button.Secondary}"
              Content="{x:Static res:Strings.ModelsAddCustom}" ToolTip="{x:Static res:Strings.ModelsAddCustomHint}"
              Command="{Binding AddCustomCommand}"
              AutomationProperties.AutomationId="Agent.Models.Add" />
      <TextBox x:Name="SearchBox" Style="{StaticResource TextBox.Field}"
               Tag="{x:Static res:Strings.ModelsSearchPlaceholder}"
               Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}"
               AutomationProperties.AutomationId="Agent.Models.Search"
               AutomationProperties.Name="{x:Static res:Strings.ModelsSearchPlaceholder}" />
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" Margin="4,6,4,0" Style="{StaticResource TextBlock.Note}" Text="{Binding Status}"
               AutomationProperties.AutomationId="Agent.Models.Status" />

    <ListBox Margin="0,6,0,0" ItemsSource="{Binding Rows}" Style="{StaticResource ListBox.Results}"
             ItemTemplateSelector="{StaticResource ModelRow.Selector}"
             HorizontalContentAlignment="Stretch"
             VirtualizingPanel.IsVirtualizing="True"
             VirtualizingPanel.VirtualizationMode="Recycling"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             AutomationProperties.AutomationId="Agent.Models.List" />
  </DockPanel>
</UserControl>
