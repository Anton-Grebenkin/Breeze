<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:activity="clr-namespace:CodeEditor.Modules.Agent.ViewModels.Activity;assembly=CodeEditor.Modules.Agent"
                    xmlns:views="clr-namespace:CodeEditor.Modules.Agent.Wpf.Views"
                    xmlns:ui="clr-namespace:CodeEditor.UI.Themes;assembly=CodeEditor.UI"
                    xmlns:controls="clr-namespace:CodeEditor.UI.Controls;assembly=CodeEditor.UI"
                    xmlns:markdown="clr-namespace:CodeEditor.UI.Markdown;assembly=CodeEditor.UI">

  <!-- Agent work block as a chain (ADR 0010): reasoning, progress, tools, checks. The rail runs through the step
       icons; new steps fade in over 120 ms, expanding takes 120 ms. -->

  <BooleanToVisibilityConverter x:Key="Activity.BoolToVisibility" />

  <!--
    Feed typography: one font (Font.Ui), no italics, three levels:
    - model narrative (answer and progress lines): FontSize.Chat, primary color, Markdown;
    - harness lines (tools, headers, checks): FontSize.Normal, muted; their result uses FontSize.Small;
    - reasoning: FontSize.Small, muted, so the model's inner voice does not compete with the narrative.
    The step icon sits on the first text line: the 3 and 16 px rows of the step grid have MaxHeight, otherwise WPF
    gives them part of the multi-line text's height.
  -->
  <Style x:Key="Activity.Text" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Normal}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="LineHeight" Value="{DynamicResource LineHeight.Chat}" />
    <!-- One line height across font sizes gives one baseline, so the step title and result line up. -->
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <Style x:Key="Activity.Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Icon}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
  </Style>

  <Style x:Key="Activity.Rail" TargetType="Rectangle">
    <Setter Property="Width" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Widget.Border}" />
  </Style>

  <!-- Toggle header: chevron and text; click or Enter/Space expands. -->
  <Style x:Key="Activity.Toggle" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="Margin" Value="-2,0,0,0" />
  </Style>

  <!-- A chain step fades in: opacity 0 → 1 over 120 ms. The pulsing and spinning icons below are continuous progress
       indicators, not transitions; the 150 ms animation limit applies to transitions. -->
  <Style x:Key="Activity.Item" TargetType="Grid">
    <Style.Triggers>
      <EventTrigger RoutedEvent="Loaded">
        <BeginStoryboard>
          <Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Style.Triggers>
  </Style>

  <!-- Step text is selectable and copyable, not editable. -->
  <Style x:Key="Activity.TextBox" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Reasoning is always visible: in a live turn it is expanded and streams under "Thinking…", then reads "Thought
       for 6 s"; a click collapses it. Small and muted so the inner voice does not compete with the narrative. -->
  <DataTemplate x:Key="Activity.Thinking" DataType="{x:Type activity:ThinkingItemViewModel}">
    <Grid x:Name="Root" Style="{StaticResource Activity.Item}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="3" MaxHeight="3" />
        <RowDefinition Height="16" MaxHeight="16" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Rectangle x:Name="RailTop" Style="{StaticResource Activity.Rail}" />
      <TextBlock Grid.Row="1" Style="{StaticResource Activity.Icon}" Text="{x:Static ui:IconGlyphs.Sparkle}" />
      <Rectangle x:Name="RailBottom" Grid.Row="2" Style="{StaticResource Activity.Rail}" />
      <StackPanel Grid.Column="1" Grid.RowSpan="3" Margin="4,0,0,6">
        <Button Style="{StaticResource Activity.Toggle}" Command="{Binding ToggleCommand}"
                AutomationProperties.AutomationId="Agent.Activity.Thinking" AutomationProperties.Name="{Binding Title}">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Title" Style="{StaticResource Activity.Text}" Text="{Binding Title}" />
            <TextBlock x:Name="Chevron" Margin="4,0,0,0" Style="{StaticResource Activity.Icon}" Text="{x:Static ui:IconGlyphs.ChevronRight}" />
          </StackPanel>
        </Button>
        <markdown:MarkdownViewer x:Name="Full" Margin="-5,0,0,2" Visibility="Collapsed"
                                 FontSize="{DynamicResource FontSize.Small}" LineHeight="{DynamicResource LineHeight.Small}"
                                 Foreground="{DynamicResource Brush.Text.Secondary}" Markdown="{Binding Message.Text, Mode=OneWay}"
                                 CodeFontSize="{DynamicResource FontSize.Code.Small}"
                                 AutomationProperties.AutomationId="Agent.Activity.ThinkingText" />
      </StackPanel>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsFirst}" Value="True">
        <Setter TargetName="RailTop" Property="Visibility" Value="Hidden" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsLast}" Value="True">
        <Setter TargetName="RailBottom" Property="Visibility" Value="Hidden" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsStreaming}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="Pulse">
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetName="Title" Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.9" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="Pulse" />
        </DataTrigger.ExitActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsExpanded}" Value="True">
        <Setter TargetName="Full" Property="Visibility" Value="Visible" />
        <Setter TargetName="Chevron" Property="Text" Value="{x:Static ui:IconGlyphs.ChevronDown}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Tool: icon, "Read Order.cs", then the result; the icon spins while running and shows an error on failure. -->
  <DataTemplate x:Key="Activity.Tool" DataType="{x:Type activity:ActivityEntryViewModel}">
    <Grid x:Name="Root" Style="{StaticResource Activity.Item}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="3" MaxHeight="3" />
        <RowDefinition Height="16" MaxHeight="16" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Rectangle x:Name="RailTop" Style="{StaticResource Activity.Rail}" />
      <TextBlock x:Name="Icon" Grid.Row="1" Style="{StaticResource Activity.Icon}"
                 Text="{Binding Message.Tool.Icon, Converter={x:Static views:ToolIconConverter.Instance}, FallbackValue={x:Static ui:IconGlyphs.Gear}}">
        <TextBlock.RenderTransform>
          <RotateTransform />
        </TextBlock.RenderTransform>
      </TextBlock>
      <Rectangle x:Name="RailBottom" Grid.Row="2" Style="{StaticResource Activity.Rail}" />
      <!-- The title is trimmed with an ellipsis and the result ("+6 −2", "exit 0") follows it, always visible: the
           grid is left-aligned, so a short title does not push the result to the right edge. -->
      <controls:AutomationBorder Grid.Column="1" Grid.RowSpan="3" Margin="4,0,0,4"
                                 AutomationProperties.AutomationId="Agent.Tool" AutomationProperties.Name="{Binding Message.Text}">
        <Grid HorizontalAlignment="Left">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Plain" Style="{StaticResource Activity.Text}" Text="{Binding Message.Text, Mode=OneWay}" ToolTip="{Binding Message.Text}" />
          <TextBlock x:Name="Linked" Style="{StaticResource Activity.Text}" Visibility="Collapsed">
            <Hyperlink TextDecorations="{x:Null}" Foreground="{DynamicResource Brush.Text.Secondary}" ToolTip="{Binding Message.Tool.FilePath}"
                       Tag="{Binding Message.Tool.FilePath}"
                       AutomationProperties.AutomationId="Agent.Tool.File">
              <Run Text="{Binding Message.Text, Mode=OneWay}" />
            </Hyperlink>
          </TextBlock>
          <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Activity.Text}" TextTrimming="None"
                     FontSize="{DynamicResource FontSize.Small}" Text="{Binding Message.Tool.Detail, Mode=OneWay}" />
        </Grid>
      </controls:AutomationBorder>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsFirst}" Value="True">
        <Setter TargetName="RailTop" Property="Visibility" Value="Hidden" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsLast}" Value="True">
        <Setter TargetName="RailBottom" Property="Visibility" Value="Hidden" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Message.Tool.HasFile}" Value="True">
        <Setter TargetName="Plain" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Linked" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Message.Tool.IsFailure}" Value="True">
        <Setter TargetName="Icon" Property="Text" Value="{x:Static ui:IconGlyphs.Error}" />
        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Brush.Error.Foreground}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Message.IsInProgress}" Value="True">
        <Setter TargetName="Icon" Property="Text" Value="{x:Static ui:IconGlyphs.Loading}" />
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="Spin">
            <Storyboard RepeatBehavior="Forever">
              <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                               From="0" To="360" Duration="0:0:1" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="Spin" />
        </DataTrigger.ExitActions>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Progress between calls (e.g. "Reading order services"): feed text, selectable and copyable. -->
  <DataTemplate x:Key="Activity.Progress" DataType="{x:Type activity:ActivityEntryViewModel}">
    <Grid x:Name="Root" Style="{StaticResource Activity.Item}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="3" MaxHeight="3" />
        <RowDefinition Height="16" MaxHeight="16" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Rectangle x:Name="RailTop" Style="{StaticResource Activity.Rail}" />
      <TextBlock Grid.Row="1" Style="{StaticResource Activity.Icon}" Text="{x:Static ui:IconGlyphs.CircleSmallFilled}" />
      <Rectangle x:Name="RailBottom" Grid.Row="2" Style="{StaticResource Activity.Rail}" />
      <!-- Model text in the chain uses the same Markdown as the answer. The left offset compensates for the document
           padding (~5 px) so the text lines up with tool rows. -->
      <markdown:MarkdownViewer Grid.Column="1" Grid.RowSpan="3" Margin="-1,0,0,6"
                               FontSize="{DynamicResource FontSize.Chat}" LineHeight="{DynamicResource LineHeight.Chat}"
                               Markdown="{Binding Message.Text, Mode=OneWay}"
                               AutomationProperties.AutomationId="Agent.Progress" AutomationProperties.Name="{Binding Message.Author}" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsFirst}" Value="True">
        <Setter TargetName="RailTop" Property="Visibility" Value="Hidden" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsLast}" Value="True">
        <Setter TargetName="RailBottom" Property="Visibility" Value="Hidden" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Harness check ("Build after edits…") and context compaction: quieter and smaller. -->
  <DataTemplate x:Key="Activity.Status" DataType="{x:Type activity:ActivityEntryViewModel}">
    <Grid x:Name="Root" Style="{StaticResource Activity.Item}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="3" MaxHeight="3" />
        <RowDefinition Height="16" MaxHeight="16" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Rectangle x:Name="RailTop" Style="{StaticResource Activity.Rail}" />
      <TextBlock Grid.Row="1" Style="{StaticResource Activity.Icon}" Text="{x:Static ui:IconGlyphs.Check}" />
      <Rectangle x:Name="RailBottom" Grid.Row="2" Style="{StaticResource Activity.Rail}" />
      <TextBox Grid.Column="1" Grid.RowSpan="3" Margin="2,1,0,6" Style="{StaticResource Activity.TextBox}"
               FontSize="{DynamicResource FontSize.Normal}" Text="{Binding Message.Text, Mode=OneWay}"
               AutomationProperties.AutomationId="Agent.Status" AutomationProperties.Name="{Binding Message.Author}" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsFirst}" Value="True">
        <Setter TargetName="RailTop" Property="Visibility" Value="Hidden" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsLast}" Value="True">
        <Setter TargetName="RailBottom" Property="Visibility" Value="Hidden" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Exploration as one row: "Explored 3 files, 2 searches", or "Exploring…" with the current step while running. -->
  <DataTemplate x:Key="Activity.Exploration" DataType="{x:Type activity:ExplorationGroupViewModel}">
    <Grid x:Name="Root" Style="{StaticResource Activity.Item}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="20" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="3" MaxHeight="3" />
        <RowDefinition Height="16" MaxHeight="16" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Rectangle x:Name="RailTop" Style="{StaticResource Activity.Rail}" />
      <TextBlock Grid.Row="1" Style="{StaticResource Activity.Icon}" Text="{x:Static ui:IconGlyphs.Search}" />
      <Rectangle x:Name="RailBottom" Grid.Row="2" Style="{StaticResource Activity.Rail}" />
      <StackPanel Grid.Column="1" Grid.RowSpan="3" Margin="4,0,0,4">
        <Button Style="{StaticResource Activity.Toggle}" Command="{Binding ToggleCommand}"
                AutomationProperties.AutomationId="Agent.Activity.Exploration" AutomationProperties.Name="{Binding Title}">
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="Title" Style="{StaticResource Activity.Text}" Text="{Binding Title}" />
            <TextBlock x:Name="Current" Margin="6,0,0,0" Style="{StaticResource Activity.Text}" FontSize="{DynamicResource FontSize.Small}"
                       Text="{Binding Current}" Visibility="Collapsed" />
            <TextBlock x:Name="Chevron" Margin="4,0,0,0" Style="{StaticResource Activity.Icon}" Text="{x:Static ui:IconGlyphs.ChevronRight}" />
          </StackPanel>
        </Button>
        <ItemsControl x:Name="Entries" Margin="0,2,0,0" ItemsSource="{Binding Entries}" Focusable="False" Visibility="Collapsed">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type activity:ActivityEntryViewModel}">
              <controls:AutomationBorder Margin="0,1" AutomationProperties.AutomationId="Agent.Tool" AutomationProperties.Name="{Binding Message.Text}">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Width="16" Margin="0,0,6,0" Style="{StaticResource Activity.Icon}"
                             Text="{Binding Message.Tool.Icon, Converter={x:Static views:ToolIconConverter.Instance}, FallbackValue={x:Static ui:IconGlyphs.Gear}}" />
                  <Grid HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Plain" Style="{StaticResource Activity.Text}" Text="{Binding Message.Text, Mode=OneWay}" ToolTip="{Binding Message.Text}" />
                    <TextBlock x:Name="Linked" Style="{StaticResource Activity.Text}" Visibility="Collapsed">
                      <Hyperlink TextDecorations="{x:Null}" Foreground="{DynamicResource Brush.Text.Secondary}" ToolTip="{Binding Message.Tool.FilePath}"
                                 Tag="{Binding Message.Tool.FilePath}"
                                 AutomationProperties.AutomationId="Agent.Tool.File">
                        <Run Text="{Binding Message.Text, Mode=OneWay}" />
                      </Hyperlink>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource Activity.Text}" TextTrimming="None"
                               FontSize="{DynamicResource FontSize.Small}" Text="{Binding Message.Tool.Detail, Mode=OneWay}" />
                  </Grid>
                </DockPanel>
              </controls:AutomationBorder>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Message.Tool.HasFile}" Value="True">
                  <Setter TargetName="Plain" Property="Visibility" Value="Collapsed" />
                  <Setter TargetName="Linked" Property="Visibility" Value="Visible" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsFirst}" Value="True">
        <Setter TargetName="RailTop" Property="Visibility" Value="Hidden" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsLast}" Value="True">
        <Setter TargetName="RailBottom" Property="Visibility" Value="Hidden" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsRunning}" Value="True">
        <Setter TargetName="Current" Property="Visibility" Value="Visible" />
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="Pulse">
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetName="Title" Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.9" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="Pulse" />
        </DataTrigger.ExitActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsExpanded}" Value="True">
        <Setter TargetName="Entries" Property="Visibility" Value="Visible" />
        <Setter TargetName="Chevron" Property="Text" Value="{x:Static ui:IconGlyphs.ChevronDown}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <views:ActivityTemplateSelector x:Key="ActivityTemplateSelector"
                                  Thinking="{StaticResource Activity.Thinking}"
                                  Exploration="{StaticResource Activity.Exploration}"
                                  Tool="{StaticResource Activity.Tool}"
                                  Progress="{StaticResource Activity.Progress}"
                                  Status="{StaticResource Activity.Status}" />

  <!-- Work block: "Working · 12 s" (pulsing) or "Worked 42 s · 9 actions"; a click expands the chain. -->
  <DataTemplate x:Key="Feed.Block" DataType="{x:Type activity:ActivityBlockViewModel}">
    <StackPanel Margin="12,6,8,6">
      <Button Style="{StaticResource Activity.Toggle}" Command="{Binding ToggleCommand}"
              AutomationProperties.AutomationId="Agent.Activity" AutomationProperties.Name="{Binding Title}">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="Chevron" Width="16" Margin="0,0,4,0" Style="{StaticResource Activity.Icon}" Text="{x:Static ui:IconGlyphs.ChevronRight}" />
          <TextBlock x:Name="Title" Style="{StaticResource Activity.Text}" Text="{Binding Title}" />
        </StackPanel>
      </Button>
      <ItemsControl x:Name="Chain" Margin="0,4,0,0" ItemsSource="{Binding Items}" Focusable="False" Visibility="Collapsed"
                    ItemTemplateSelector="{StaticResource ActivityTemplateSelector}"
                    AutomationProperties.AutomationId="Agent.Activity.Chain" />
    </StackPanel>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsExpanded}" Value="True">
        <Setter TargetName="Chain" Property="Visibility" Value="Visible" />
        <Setter TargetName="Chevron" Property="Text" Value="{x:Static ui:IconGlyphs.ChevronDown}" />
        <DataTrigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Chain" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.12" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
      </DataTrigger>
      <DataTrigger Binding="{Binding IsRunning}" Value="True">
        <DataTrigger.EnterActions>
          <BeginStoryboard x:Name="Pulse">
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetName="Title" Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.9" />
            </Storyboard>
          </BeginStoryboard>
        </DataTrigger.EnterActions>
        <DataTrigger.ExitActions>
          <StopStoryboard BeginStoryboardName="Pulse" />
        </DataTrigger.ExitActions>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

</ResourceDictionary>
