<UserControl x:Class="CodeEditor.Shell.Wpf.Views.EditorGroupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:editors="clr-namespace:CodeEditor.Shell.Editors;assembly=CodeEditor.Shell"
             xmlns:ui="clr-namespace:CodeEditor.UI.Themes;assembly=CodeEditor.UI"
             xmlns:controls="clr-namespace:CodeEditor.UI.Controls;assembly=CodeEditor.UI"
             xmlns:views="clr-namespace:CodeEditor.Shell.Wpf.Views"
             xmlns:res="clr-namespace:CodeEditor.Shell.Resources;assembly=CodeEditor.Shell"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=editors:EditorGroupViewModel}"
             AutomationProperties.AutomationId="{Binding AutomationId}">
  <UserControl.Resources>
    <!-- Tab close button: a dot for a modified file, a cross on hover, as in VS Code. -->
    <Style x:Key="Button.TabClose" TargetType="Button">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Tab.InactiveForeground}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
              <Grid>
                <TextBlock x:Name="Cross"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontFamily="{DynamicResource Font.Icons}" FontSize="{DynamicResource FontSize.CaptionIcon}"
                           Text="{x:Static ui:IconGlyphs.Close}" />
                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Brush.Tab.Modified}" Visibility="Collapsed" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsDirty}" Value="True">
                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                <Setter TargetName="Cross" Property="Visibility" Value="Collapsed" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Control.HoverBackground}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- Tab group (ADR 0031): tab strip and the shown tab; tabs drag between groups and to the edges. -->
  <DockPanel>
    <!-- The whole strip accepts drops; empty space on the right appends to the group. -->
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled"
                  Background="{DynamicResource Brush.Tab.InactiveBackground}"
                  AllowDrop="True" DragOver="OnTabStripDragOver" Drop="OnTabStripDrop">
      <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs}" Focusable="False" MinHeight="35"
                    Padding="4,0,0,0"
                    Background="Transparent"
                    AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.Tabs}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type editors:EditorTab}">
            <!-- Rounded-top tab: the shown one has a background, the active one an accent bar below (ADR 0038). -->
            <controls:AutomationBorder x:Name="Tab"
                    Height="31"
                    Margin="0,4,2,0"
                    Padding="12,0,8,0"
                    CornerRadius="6,6,0,0"
                    Background="{DynamicResource Brush.Tab.InactiveBackground}"
                    ToolTip="{Binding ToolTip}"
                    MouseLeftButtonDown="OnTabMouseDown"
                    MouseMove="OnTabMouseMove"
                    MouseUp="OnTabMouseUp"
                    MouseRightButtonDown="OnTabRightButtonDown"
                    Tag="{Binding Host, RelativeSource={RelativeSource AncestorType=views:EditorGroupView}}"
                    AutomationProperties.AutomationId="{Binding AutomationId}"
                    AutomationProperties.Name="{Binding Title}">
              <controls:AutomationBorder.ContextMenu>
                <!-- The menu is outside the visual tree, so it reaches the area via the tab's Tag through PlacementTarget. -->
                <ContextMenu ItemsSource="{Binding PlacementTarget.Tag.TabContextMenu.Items, RelativeSource={RelativeSource Self}}"
                             ItemContainerStyle="{StaticResource MenuItem.Bound}" />
              </controls:AutomationBorder.ContextMenu>
              <Grid>
                <Border x:Name="ActiveMarker" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,4,0"
                        Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="Title" VerticalAlignment="Center" Text="{Binding Title}"
                             Foreground="{DynamicResource Brush.Tab.InactiveForeground}" />
                  <Button Style="{StaticResource Button.TabClose}"
                          Command="{Binding Host.Editors.CloseCommand, RelativeSource={RelativeSource AncestorType=views:EditorGroupView}}"
                          CommandParameter="{Binding}"
                          ToolTip="{x:Static res:Strings.CloseTabToolTip}"
                          AutomationProperties.AutomationId="{Binding AutomationId, StringFormat={}{0}.Close}"
                          AutomationProperties.Name="{x:Static res:Strings.Close}" />
                </StackPanel>
              </Grid>
            </controls:AutomationBorder>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsShown}" Value="True">
                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Brush.Tab.ActiveBackground}" />
                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.Tab.ActiveForeground}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="ActiveMarker" Property="Visibility" Value="Visible" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsPreview}" Value="True">
                <Setter TargetName="Title" Property="FontStyle" Value="Italic" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HasProblem}" Value="True">
                <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
              </DataTrigger>
              <!-- Agent edits awaiting review (ADR 0040): the title is highlighted until they are accepted or rejected. -->
              <DataTrigger Binding="{Binding HasPendingReview}" Value="True">
                <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource Brush.AgentChange.Foreground}" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    </Border>

    <!-- Content of all tabs; only one is visible, so caret and scroll survive. DropHint shows where a tab will land. -->
    <Grid x:Name="EditorContent" AllowDrop="True" Background="Transparent"
          DragOver="OnContentDragOver" Drop="OnContentDrop">
      <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Grid />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type editors:EditorTab}">
            <ContentControl Content="{Binding Editor}"
                            Focusable="False"
                            Visibility="{Binding IsShown, Converter={StaticResource BoolToVisibility}}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Border x:Name="DropHint" Background="{DynamicResource Brush.Accent}" Opacity="0.15"
              IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
  </DockPanel>
</UserControl>
