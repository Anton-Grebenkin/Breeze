<UserControl x:Class="CodeEditor.Shell.Wpf.Views.EditorAreaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:editors="clr-namespace:CodeEditor.Shell.Editors;assembly=CodeEditor.Shell"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=editors:EditorAreaHost}"
             AutomationProperties.AutomationId="EditorArea">
  <!-- Tab groups side by side with splitters (ADR 0031); code-behind builds the columns from the group list. -->
  <Grid x:Name="GroupsHost" />
</UserControl>
