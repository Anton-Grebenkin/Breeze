<UserControl x:Class="CodeEditor.Shell.Wpf.Views.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:palette="clr-namespace:CodeEditor.Shell.Palette;assembly=CodeEditor.Shell"
             xmlns:controls="clr-namespace:CodeEditor.UI.Controls;assembly=CodeEditor.UI"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=palette:CommandPaletteViewModel}"
             Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
  <Grid>
    <!-- Transparent backdrop: a click outside the palette closes it. -->
    <Border Background="Transparent" MouseDown="OnBackdropMouseDown" />

    <Border Width="600"
            Margin="0,4,0,0"
            Padding="0,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource Border.Widget}"
            AutomationProperties.AutomationId="CommandPalette">
      <StackPanel>
        <TextBox x:Name="QueryBox"
                 Margin="6,0,6,6"
                 Style="{StaticResource TextBox.Input}"
                 Tag="{Binding Placeholder}"
                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                 PreviewKeyDown="OnQueryPreviewKeyDown"
                 AutomationProperties.AutomationId="CommandPalette.Query"
                 AutomationProperties.Name="{Binding Placeholder}" />

        <ListBox x:Name="ResultList"
                 MaxHeight="360"
                 Style="{StaticResource ListBox.Results}"
                 ItemsSource="{Binding Items}"
                 SelectedIndex="{Binding SelectedIndex}"
                 SelectionChanged="OnSelectionChanged"
                 AutomationProperties.AutomationId="CommandPalette.Results">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItem.Result}">
              <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnItemClick" />
              <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id, StringFormat=CommandPalette.Item.{0}}" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type palette:PaletteItem}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:HighlightedTextBlock SourceText="{Binding Title}"
                                               Highlights="{Binding Highlights}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                <!-- The file's folder, muted as in VS Code; commands have none. -->
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{DynamicResource FontSize.Small}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           Text="{Binding Detail}"
                           TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="2"
                        Margin="12,0,0,0"
                        Style="{StaticResource Border.Keycap}"
                        Visibility="{Binding Shortcut, Converter={x:Static controls:NullToCollapsedConverter.Instance}}">
                  <TextBlock FontSize="{DynamicResource FontSize.Small}" Text="{Binding Shortcut}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Margin="14,4"
                   Foreground="{DynamicResource Brush.Text.Secondary}"
                   Text="{Binding EmptyText}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"
                   AutomationProperties.AutomationId="CommandPalette.Empty" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
