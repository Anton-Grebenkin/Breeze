<Window x:Class="CodeEditor.Shell.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CodeEditor.Shell.ViewModels;assembly=CodeEditor.Shell"
        xmlns:ui="clr-namespace:CodeEditor.UI.Themes;assembly=CodeEditor.UI"
        xmlns:views="clr-namespace:CodeEditor.Shell.Wpf.Views"
        xmlns:res="clr-namespace:CodeEditor.Shell.Resources;assembly=CodeEditor.Shell"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="{Binding TitleBar.WindowTitle}"
        Width="1200" Height="800" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        Foreground="{DynamicResource Brush.Text.Primary}"
        FontFamily="{DynamicResource Font.Ui}"
        FontSize="{DynamicResource FontSize.Normal}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        AutomationProperties.AutomationId="MainWindow">

  <!--
    Text renders like Windows 11 apps (ADR 0038): Ideal mode with subpixel glyph positions and grayscale antialiasing.
    Display mode snapped Inter and Codicons to whole pixels (wider glyphs, jagged edges) and ClearType added color
    fringes. Editor code uses Display (TextEditorView), where monospaced Cascadia Mono is sharper on the pixel grid.
    Context menus and tooltips are separate windows, so their styles repeat these settings.
  -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False"
                  ResizeBorderThickness="6" />
  </WindowChrome.WindowChrome>

  <Border x:Name="Root"
          BorderBrush="{DynamicResource Brush.Window.Border}"
          BorderThickness="1">
    <!-- Interface zoom scales this grid (WindowZoomBinder); the 1 px window border stays crisp. -->
    <Grid x:Name="ZoomRoot">
      <Grid.RowDefinitions>
        <RowDefinition Height="40" />
        <RowDefinition Height="*" />
        <RowDefinition Height="26" />
      </Grid.RowDefinitions>

      <!--
        Title bar: Breeze mark and menu on the left, search box centered, caption buttons on the right (ADR 0038).
        TitleBarPanel keeps the search centered while it fits and shrinks it instead of covering the menu.
      -->
      <views:TitleBarPanel Grid.Row="0"
                           DataContext="{Binding TitleBar}"
                           Background="{DynamicResource Brush.TitleBar.Background}"
                           AutomationProperties.AutomationId="TitleBar">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
          <Path Width="22" Height="22"
                Margin="14,0,6,0"
                VerticalAlignment="Center"
                Stretch="Uniform"
                Data="{StaticResource Geometry.BrandMark}"
                Fill="{DynamicResource Brush.Brand}"
                AutomationProperties.AutomationId="TitleBar.Brand" />
          <Menu Style="{StaticResource Menu.Bar}"
                VerticalAlignment="Center"
                ItemsSource="{Binding MenuBar.Items}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                AutomationProperties.AutomationId="MenuBar" />
        </StackPanel>

        <Button MinWidth="160"
                MaxWidth="400"
                Style="{StaticResource Button.CommandCenter}"
                Command="{Binding QuickOpenCommand}"
                ToolTip="{Binding SearchShortcut}"
                WindowChrome.IsHitTestVisibleInChrome="True"
                AutomationProperties.AutomationId="TitleBar.Search"
                AutomationProperties.Name="{Binding SearchText}">
          <StackPanel Orientation="Horizontal">
            <TextBlock FontFamily="{DynamicResource Font.Icons}"
                       FontSize="{DynamicResource FontSize.CaptionIcon}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       Text="{x:Static ui:IconGlyphs.Search}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding SearchText}" />
          </StackPanel>
        </Button>

        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <!-- Layout toggles as in VS Code: left, bottom and right areas; a filled icon means the area is open. -->
          <StackPanel Margin="0,0,8,0"
                      Orientation="Horizontal"
                      DataContext="{Binding DataContext.Layout, RelativeSource={RelativeSource AncestorType=Window}}"
                      WindowChrome.IsHitTestVisibleInChrome="True">
            <Button DataContext="{Binding SideBar}" Command="{Binding ToggleCommand}"
                    ToolTip="{x:Static res:Strings.SideBarToolTip}"
                    AutomationProperties.AutomationId="TitleBar.ToggleSideBar" AutomationProperties.Name="{x:Static res:Strings.SideBar}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Button.LayoutToggle}">
                  <Setter Property="Content" Value="{x:Static ui:IconGlyphs.LayoutSideBarLeftOff}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisible}" Value="True">
                      <Setter Property="Content" Value="{x:Static ui:IconGlyphs.LayoutSideBarLeft}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button DataContext="{Binding Panel}" Command="{Binding ToggleCommand}"
                    ToolTip="{x:Static res:Strings.PanelToolTip}"
                    AutomationProperties.AutomationId="TitleBar.TogglePanel" AutomationProperties.Name="{x:Static res:Strings.Panel}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Button.LayoutToggle}">
                  <Setter Property="Content" Value="{x:Static ui:IconGlyphs.LayoutPanelOff}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisible}" Value="True">
                      <Setter Property="Content" Value="{x:Static ui:IconGlyphs.LayoutPanel}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <Button DataContext="{Binding SecondarySideBar}" Command="{Binding ToggleCommand}"
                    ToolTip="{x:Static res:Strings.SecondarySideBarToolTip}"
                    AutomationProperties.AutomationId="TitleBar.ToggleSecondarySideBar" AutomationProperties.Name="{x:Static res:Strings.SecondarySideBar}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource Button.LayoutToggle}">
                  <Setter Property="Content" Value="{x:Static ui:IconGlyphs.LayoutSideBarRightOff}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVisible}" Value="True">
                      <Setter Property="Content" Value="{x:Static ui:IconGlyphs.LayoutSideBarRight}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
          <views:CaptionButtons />
        </StackPanel>
      </views:TitleBarPanel>

      <views:WorkbenchView Grid.Row="1" />

      <Border Grid.Row="2"
              Padding="8,0"
              Background="{DynamicResource Brush.StatusBar.Background}"
              TextElement.FontFamily="{DynamicResource Font.Ui.Small}"
              AutomationProperties.AutomationId="StatusBar">
        <DockPanel>
          <!-- Module items on the right (position, encoding, language); clickable when they have a command. -->
          <ItemsControl DockPanel.Dock="Right"
                        ItemsSource="{Binding StatusBar.Items}"
                        Focusable="False"
                        VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:StatusBarItemViewModel}">
                <Button x:Name="Item"
                        Padding="6,0"
                        Style="{StaticResource Button.Subtle}"
                        Foreground="{DynamicResource Brush.StatusBar.Foreground}"
                        FontSize="{DynamicResource FontSize.Small}"
                        Content="{Binding Text}"
                        ToolTip="{Binding ToolTip}"
                        Command="{Binding Command}"
                        Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="{Binding AutomationId}"
                        AutomationProperties.Name="{Binding Text}" />
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Command}" Value="{x:Null}">
                    <Setter TargetName="Item" Property="IsHitTestVisible" Value="False" />
                    <Setter TargetName="Item" Property="Focusable" Value="False" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource Brush.StatusBar.Foreground}"
                     FontSize="{DynamicResource FontSize.Small}"
                     Text="{Binding StatusBar.Message}"
                     AutomationProperties.AutomationId="StatusBar.Message" />
        </DockPanel>
      </Border>

      <!-- Palette over the window below the title bar; its view is created on first open for faster startup. -->
      <ContentControl x:Name="PaletteHost" Grid.Row="1" Grid.RowSpan="2" Focusable="False" />
    </Grid>
  </Border>
</Window>
