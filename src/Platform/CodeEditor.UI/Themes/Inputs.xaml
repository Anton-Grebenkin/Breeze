<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:markdown="clr-namespace:CodeEditor.UI.Markdown">

  <!-- Inputs and lists: command palette, quick open, search. -->

  <!-- Input with a placeholder passed via Tag. -->
  <Style x:Key="TextBox.Input" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Input.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4">
            <!--
              TextBox applies Padding to its text view itself, so the host gets no margin (it doubled the inset and
              the caret landed inside the placeholder). The view adds 2 px before the first character: the placeholder
              starts at Padding + 2 px, exactly where typed text and the caret start.
            -->
            <Grid>
              <TextBlock x:Name="Placeholder"
                         Margin="{TemplateBinding Padding}"
                         Padding="2,0,0,0"
                         Visibility="Collapsed"
                         IsHitTestVisible="False"
                         Foreground="{DynamicResource Brush.Text.Secondary}"
                         Text="{TemplateBinding Tag}" />
              <ScrollViewer x:Name="PART_ContentHost"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A field among other fields (search panel, find widget): accent border only when focused. -->
  <Style x:Key="TextBox.Field" TargetType="TextBox" BasedOn="{StaticResource TextBox.Input}">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Input.Border}" />
    <Setter Property="Padding" Value="4,3" />
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus.Border}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Masked input (API key), styled like TextBox.Field. -->
  <Style x:Key="PasswordBox.Field" TargetType="PasswordBox">
    <Setter Property="Background" Value="{DynamicResource Brush.Input.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Input.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Padding" Value="4,3" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus.Border}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Result list row with hover and selection backgrounds. -->
  <Style x:Key="ListBoxItem.Result" TargetType="ListBoxItem">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="4,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.List.HoverBackground}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.List.SelectionBackground}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.List.SelectionForeground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ListBox.Results" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItem.Result}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
  </Style>

  <!-- Popup surface: menus, palette. -->
  <Style x:Key="Border.Widget" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Widget.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Widget.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.35" />
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Read-only Markdown (agent replies): no border or own scrolling, accent selection. -->
  <Style TargetType="markdown:MarkdownViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Normal}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="markdown:MarkdownViewer">
          <ScrollViewer x:Name="PART_ContentHost"
                        Background="{TemplateBinding Background}"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Disabled" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
