<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:CodeEditor.UI.Themes"
                    xmlns:controls="clr-namespace:CodeEditor.UI.Controls">

  <!--
    Trees: 24 px rows, FontSize.Tree, 10 px per level so deep folders fit a narrow side bar. Selection is a rounded
    background with an accent bar on the left (ADR 0038); the expander arrow rotates.
  -->

  <Style x:Key="ToggleButton.TreeExpander" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border Background="Transparent">
            <TextBlock x:Name="Arrow"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5"
                       FontFamily="{DynamicResource Font.Icons}"
                       FontSize="{DynamicResource FontSize.Icon}"
                       Text="{x:Static ui:IconGlyphs.ChevronRight}">
              <TextBlock.RenderTransform>
                <RotateTransform Angle="0" />
              </TextBlock.RenderTransform>
            </TextBlock>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Arrow" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="90" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TreeViewItem.Row" TargetType="TreeViewItem">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <!-- Nested levels are virtualized too: a folder with thousands of files doesn't create thousands of rows. -->
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TreeViewItem">
          <!-- Item: the row and its children; a drop target folder is painted whole, as in VS Code. -->
          <StackPanel x:Name="Item">
            <!-- Row: rounded background inset from the panel edges; accent bar on the focused selection. -->
            <Grid x:Name="RowHost" Height="24" Background="Transparent">
              <Border x:Name="Row" Margin="4,0" CornerRadius="5" Background="Transparent" />
              <Border x:Name="Marker" Width="3" Height="12" Margin="4,0,0,0" CornerRadius="1.5"
                      HorizontalAlignment="Left" VerticalAlignment="Center"
                      Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" />
              <Grid Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:TreeIndentConverter.Instance}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="Expander"
                              ClickMode="Press"
                              Style="{StaticResource ToggleButton.TreeExpander}"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" />
              </Grid>
            </Grid>
            <ItemsPresenter x:Name="ItemsHost" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="False">
              <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger SourceName="RowHost" Property="IsMouseOver" Value="True">
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.List.HoverBackground}" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="Selector.IsSelectionActive" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.List.HoverBackground}" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True" />
                <Condition Property="Selector.IsSelectionActive" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.List.SelectionBackground}" />
              <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.List.SelectionForeground}" />
            </MultiTrigger>
            <Trigger Property="controls:DropHighlight.IsActive" Value="True">
              <Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.List.DropBackground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TreeView.Files" TargetType="TreeView">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource TreeViewItem.Row}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Tree}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item" />
    <!-- Dropping onto empty space goes to the root folder: the whole tree is the target. -->
    <Style.Triggers>
      <Trigger Property="controls:DropHighlight.IsActive" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.List.DropBackground}" />
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>
