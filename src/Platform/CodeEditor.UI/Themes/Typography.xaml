<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    UI and chat font: Inter bundled in the assembly (ADR 0038): tall x-height, even rhythm, legible when small,
    supports Cyrillic. Static weights only: WPF doesn't understand variable fonts such as Segoe UI Variable (it renders
    semibold as regular and ignores optical sizes). Segoe UI is the fallback. Role keys (Small, Display) let a role
    change in one place. Code uses Cascadia Mono, as in Visual Studio: without ligatures "=>" reads as typed;
    ligatures are available via editor.fontFamily.
  -->
  <FontFamily x:Key="Font.Ui">pack://application:,,,/CodeEditor.UI;component/Fonts/#Inter, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Ui.Small">pack://application:,,,/CodeEditor.UI;component/Fonts/#Inter, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Display">pack://application:,,,/CodeEditor.UI;component/Fonts/#Inter, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Code">Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Font.Icons">pack://application:,,,/CodeEditor.UI;component/Fonts/#codicon</FontFamily>

  <!--
    Sizes: UI 13 px, chat text 14 px. Inter has a taller x-height than Segoe UI, so 13 px Inter reads like 14 px Segoe.
    Small is for the status bar, counters and captions.
  -->
  <sys:Double x:Key="FontSize.Small">12</sys:Double>
  <sys:Double x:Key="FontSize.Normal">13</sys:Double>
  <!-- Product name on the welcome page. -->
  <sys:Double x:Key="FontSize.Heading">44</sys:Double>
  <sys:Double x:Key="FontSize.Chat">14</sys:Double>
  <!-- Trees (explorer, search results): UI size, 24 px rows (Trees.xaml). -->
  <sys:Double x:Key="FontSize.Tree">13</sys:Double>
  <!-- Monospace looks larger than proportional text at the same size, so inline code is one step smaller. -->
  <sys:Double x:Key="FontSize.Code">13</sys:Double>
  <!-- Code in small text (reasoning): one step smaller, or monospaced words stick out of the line. -->
  <sys:Double x:Key="FontSize.Code.Small">11.5</sys:Double>
  <!-- Chat line height is about 1.6× the font size: dense text in a narrow panel reads poorly. -->
  <sys:Double x:Key="LineHeight.Chat">22</sys:Double>
  <!-- Multi-line small text (model reasoning): about 1.5× the font size. -->
  <sys:Double x:Key="LineHeight.Small">18</sys:Double>
  <!-- Markdown headings in chat: restrained, the panel is narrow. -->
  <sys:Double x:Key="FontSize.Markdown.H1">20</sys:Double>
  <sys:Double x:Key="FontSize.Markdown.H2">17</sys:Double>
  <sys:Double x:Key="FontSize.Markdown.H3">15</sys:Double>
  <!-- Codicons are drawn on a 16 px grid; smaller sizes blur the lines. -->
  <sys:Double x:Key="FontSize.CaptionIcon">16</sys:Double>
  <sys:Double x:Key="FontSize.Icon">16</sys:Double>
  <!--
    Activity bar: 22 px icons drawn as geometry (GlyphIcon) with a 0.4 px outline. As text, 16 px-grid Codicons get
    1.25–1.5 px lines at this size that look jagged; the outline makes lines ~1.8 px with even edges.
  -->
  <sys:Double x:Key="FontSize.ActivityIcon">22</sys:Double>
  <sys:Double x:Key="IconWeight.Activity">0.4</sys:Double>

</ResourceDictionary>
