<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

  <!-- Dark theme. Keys match Colors.Light.xaml and ThemeKeys. -->

  <SolidColorBrush x:Key="Brush.Window.Background" Color="#1F2123" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Window.Border" Color="#3A3B3D" po:Freeze="True" />

  <!-- Cards (ADR 0038): documents, bottom panel and secondary side bar sit on the window background with a thin stroke. -->
  <SolidColorBrush x:Key="Brush.Card.Border" Color="#17FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Panel.Background" Color="#242528" po:Freeze="True" />
  <!-- Breeze mark color, the same in both themes. -->
  <SolidColorBrush x:Key="Brush.Brand" Color="#37BBC1" po:Freeze="True" />

  <!-- Explorer file icon colors by file kind (ADR 0038): warm folders, code in the brand color. -->
  <SolidColorBrush x:Key="Brush.FileIcon.Folder" Color="#D3A75E" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.FileIcon.Code" Color="#4CC3C8" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.FileIcon.Data" Color="#B79CF2" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.FileIcon.Document" Color="#74A9F0" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.FileIcon.Media" Color="#E58CB3" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.FileIcon.Table" Color="#73C991" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.FileIcon.Pdf" Color="#EE7B7B" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.FileIcon.Slides" Color="#EE9F5C" po:Freeze="True" />
  <!-- Files with agent edits awaiting review: name in the explorer and the tab title (ADR 0040). -->
  <SolidColorBrush x:Key="Brush.AgentChange.Foreground" Color="#5FD4D9" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.TitleBar.Background" Color="#1F2123" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.TitleBar.Foreground" Color="#CCCCCC" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.TitleBar.InactiveForeground" Color="#8B8B8B" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.ActivityBar.Background" Color="#1F2123" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.ActivityBar.Foreground" Color="#D7D7D7" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.ActivityBar.InactiveForeground" Color="#868686" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Editor.Background" Color="#191A1C" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Editor.Foreground" Color="#CCCCCC" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Editor.Selection" Color="#264F78" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Editor.LineHighlight" Color="#282828" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Editor.LineNumber" Color="#6E7681" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Editor.FindMatch" Color="#66EA5C00" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Syntax.Comment" Color="#6A9955" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Syntax.String" Color="#CE9178" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Syntax.Number" Color="#B5CEA8" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Syntax.Keyword" Color="#569CD6" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Syntax.ControlKeyword" Color="#C586C0" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Syntax.Function" Color="#DCDCAA" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Syntax.Type" Color="#4EC9B0" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Syntax.Tag" Color="#569CD6" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Syntax.Attribute" Color="#9CDCFE" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Syntax.Variable" Color="#9CDCFE" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Syntax.Preprocessor" Color="#9B9B9B" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Tab.ActiveBackground" Color="#1AFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Tab.InactiveBackground" Color="#00000000" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Tab.ActiveForeground" Color="#FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Tab.InactiveForeground" Color="#9D9D9D" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Tab.Modified" Color="#CCCCCC" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.StatusBar.Background" Color="#1F2123" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.StatusBar.Foreground" Color="#B4B4B4" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Border" Color="#2B2B2B" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Accent" Color="#37BBC1" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#04282A" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Focus.Border" Color="#37BBC1" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#E6E6E6" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#B0B0B0" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Control.HoverBackground" Color="#2D2D2D" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Control.PressedBackground" Color="#383838" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Input.Background" Color="#262626" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Input.Border" Color="#3C3C3C" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Caption.CloseHoverBackground" Color="#C42B1C" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Caption.CloseHoverForeground" Color="#FFFFFF" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Keycap.Background" Color="#2A2A2A" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Keycap.Border" Color="#3F3F3F" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Widget.Background" Color="#222222" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Widget.Border" Color="#3F3F3F" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Widget.Separator" Color="#3F3F3F" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.List.HoverBackground" Color="#0FFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.List.SelectionBackground" Color="#1AFFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.List.SelectionForeground" Color="#FFFFFF" po:Freeze="True" />
  <!-- Folder a dragged file would drop into: the accent, translucent. -->
  <SolidColorBrush x:Key="Brush.List.DropBackground" Color="#2E37BBC1" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.MatchHighlight.Foreground" Color="#4CCFD5" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Error.Foreground" Color="#F48771" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Warning.Foreground" Color="#CCA700" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Success.Foreground" Color="#89D185" po:Freeze="True" />
  <!-- Git file status, like gitDecoration.* in VS Code. -->
  <SolidColorBrush x:Key="Brush.Git.Modified" Color="#E2C08D" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Git.Added" Color="#81B88B" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Git.Deleted" Color="#C74E39" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Git.Untracked" Color="#73C991" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Git.Conflict" Color="#E4676B" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Badge.Background" Color="#616161" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Badge.Foreground" Color="#F8F8F8" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Diff.InsertedBackground" Color="#339BB955" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Diff.RemovedBackground" Color="#33FF0000" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Markdown.CodeBlockBackground" Color="#1F1F1F" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Markdown.InlineCodeBackground" Color="#17FFFFFF" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Markdown.InlineCodeForeground" Color="#A9DFE2" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Markdown.Link" Color="#5CC8CE" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Markdown.QuoteBorder" Color="#4A4A4A" po:Freeze="True" />

  <!-- Checkerboard behind transparent images, as in VS Code's image preview. -->
  <SolidColorBrush x:Key="Brush.Checkerboard.Background" Color="#1F1F1F" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Checkerboard.Square" Color="#2C2C2C" po:Freeze="True" />

  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#66797979" po:Freeze="True" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#B3A0A0A0" po:Freeze="True" />

</ResourceDictionary>
