    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Terminal.Wpf\CodeEditor.Modules.Terminal.Wpf.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Git\CodeEditor.Modules.Git.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Git.Wpf\CodeEditor.Modules.Git.Wpf.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Docker\CodeEditor.Modules.Docker.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Docker.Wpf\CodeEditor.Modules.Docker.Wpf.csproj" />
