<Project Sdk="Microsoft.NET.Sdk">

  <!-- Thin host: composes the platform and modules via Generic Host and DI. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>CodeEditor.App.Program</StartupObject>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!--
    The product is Breeze (ADR 0038): exe name, file version info (shown by Task Manager and file properties) and
    icon. Namespaces keep the CodeEditor.* code name.
  -->
  <PropertyGroup>
    <AssemblyName>Breeze</AssemblyName>
    <RootNamespace>CodeEditor.App</RootNamespace>
    <Product>Breeze</Product>
    <AssemblyTitle>Breeze</AssemblyTitle>
    <Description>Breeze Code Editor</Description>
    <ApplicationIcon>..\..\..\assets\brand\breeze.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Applies on publish: dotnet publish -c Release -r win-x64 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- App.xaml is a plain page: the entry point is our own Program.Main. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- The repository the release came from (CI passes -p:RepositoryUrl): updates and Help links. Empty in local builds. -->
  <ItemGroup Condition="'$(RepositoryUrl)' != ''">
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Platform\CodeEditor.Core\CodeEditor.Core.csproj" />
    <ProjectReference Include="..\..\Platform\CodeEditor.Shell\CodeEditor.Shell.csproj" />
    <ProjectReference Include="..\..\Platform\CodeEditor.UI\CodeEditor.UI.csproj" />
    <ProjectReference Include="..\..\Platform\CodeEditor.Shell.Wpf\CodeEditor.Shell.Wpf.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Output\CodeEditor.Modules.Output.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Output.Wpf\CodeEditor.Modules.Output.Wpf.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Explorer\CodeEditor.Modules.Explorer.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Explorer.Wpf\CodeEditor.Modules.Explorer.Wpf.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Search\CodeEditor.Modules.Search.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Search.Wpf\CodeEditor.Modules.Search.Wpf.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Agent\CodeEditor.Modules.Agent.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.Agent.Wpf\CodeEditor.Modules.Agent.Wpf.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.TextEditor\CodeEditor.Modules.TextEditor.csproj" />
    <ProjectReference Include="..\..\Modules\CodeEditor.Modules.TextEditor.Wpf\CodeEditor.Modules.TextEditor.Wpf.csproj" />
